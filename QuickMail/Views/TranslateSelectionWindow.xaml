<Window x:Class="QuickMail.Views.TranslateSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Translate Selection" Width="680" Height="570" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Theme.WindowBackground}" Foreground="{DynamicResource Theme.TextPrimary}"
        FontFamily="{DynamicResource Theme.FontFamily}" FontSize="{DynamicResource Theme.FontSizeBase}">
  <Grid Margin="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
      <TextBlock Text="From" VerticalAlignment="Center"/><ComboBox x:Name="SourceBox" Width="125" Margin="8,0,16,0"/>
      <TextBlock Text="To" VerticalAlignment="Center"/><ComboBox x:Name="TargetBox" Width="125" Margin="8,0,16,0"/>
      <TextBlock Text="Provider" VerticalAlignment="Center"/><ComboBox x:Name="ProviderBox" Width="155" Margin="8,0,0,0" SelectionChanged="ProviderBox_SelectionChanged"/>
    </StackPanel>
    <TextBox Grid.Row="1" x:Name="OriginalBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
    <Button Grid.Row="2" Content="Translate" Width="110" Margin="0,10" HorizontalAlignment="Left" Click="Translate_Click"/>
    <TextBox Grid.Row="3" x:Name="ResultBox" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
    <Grid Grid.Row="4" Margin="0,10,0,0">
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{DynamicResource Theme.TextSecondary}"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Provider settings…" Margin="0,0,8,0" Click="Settings_Click"/>
        <Button Content="Replace selection" Width="125" IsDefault="True" Click="Replace_Click"/>
        <Button Content="Cancel" Width="85" Margin="8,0,0,0" IsCancel="True"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
