<Window x:Class="QuickMail.Views.OrphanedAttachmentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Delete Orphaned Attachments" Height="680" Width="1100"
        MinHeight="450" MinWidth="760" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Theme.WindowBackground}"
        Foreground="{DynamicResource Theme.TextPrimary}"
        FontFamily="{DynamicResource Theme.FontFamily}"
        FontSize="{DynamicResource Theme.FontSizeBase}">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Orphaned attachments" FontSize="{DynamicResource Theme.FontSizeHeader}" FontWeight="SemiBold"/>
            <TextBlock x:Name="LocationText" Margin="0,4,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource Theme.TextSecondary}"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" Margin="2,0,0,8"
                       Foreground="{DynamicResource Theme.TextSecondary}"/>
            <WrapPanel HorizontalAlignment="Right">
                <Button x:Name="RemoveSelectedButton" Content="Remove selected" MinWidth="120"
                        Margin="6,0,0,0" Click="RemoveSelected_Click"/>
                <Button x:Name="RemoveAllButton" Content="Remove all" MinWidth="100"
                        Margin="6,0,0,0" Click="RemoveAll_Click"/>
                <Button x:Name="CopyButton" Content="Copy list to clipboard" MinWidth="150"
                        Margin="6,0,0,0" Click="CopyList_Click"/>
                <Button Content="Cancel" MinWidth="90" Margin="6,0,0,0"
                        IsCancel="True" Click="Cancel_Click"/>
            </WrapPanel>
        </StackPanel>

        <DataGrid x:Name="AttachmentGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Extended" SelectionUnit="FullRow" CanUserSortColumns="True"
                  EnableRowVirtualization="True" MouseDoubleClick="AttachmentGrid_MouseDoubleClick"
                  AutomationProperties.Name="Orphaned attachments">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Full path" Binding="{Binding FullPath}" Width="*" SortMemberPath="FullPath"/>
                <DataGridTextColumn Header="Date/time" Binding="{Binding LastWriteTimeDisplay}"
                                    Width="180" SortMemberPath="LastWriteTime"/>
                <DataGridTextColumn Header="Size (KB)" Binding="{Binding SizeKb, StringFormat={}{0:N0}}"
                                    Width="120" SortMemberPath="SizeKb">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/></Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
