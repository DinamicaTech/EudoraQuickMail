<Window x:Class="QuickMail.Views.GrammarCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Grammar Check" Width="760" Height="600" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Theme.WindowBackground}" Foreground="{DynamicResource Theme.TextPrimary}"
        FontFamily="{DynamicResource Theme.FontFamily}" FontSize="{DynamicResource Theme.FontSizeBase}">
  <Grid Margin="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock x:Name="SummaryText" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <ListBox Grid.Row="1" x:Name="IssuesList" ItemsSource="{Binding}">
      <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4">
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding ReplacementSummary}" TextWrapping="Wrap" Foreground="{DynamicResource Theme.TextSecondary}"/>
      </StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <TextBlock Grid.Row="2" Text="Corrected text preview" FontWeight="SemiBold" Margin="0,12,0,5"/>
    <TextBox Grid.Row="3" x:Name="CorrectedBox" AcceptsReturn="True" TextWrapping="Wrap"
             VerticalScrollBarVisibility="Auto"/>
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Cancel" Width="90" IsCancel="True"/>
      <Button Content="Apply corrections" Width="135" Margin="8,0,0,0" IsDefault="True" Click="Apply_Click"/>
    </StackPanel>
  </Grid>
</Window>
