<Window x:Class="QuickMail.Views.RulePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rule Preview" Height="520" Width="900"
        MinHeight="360" MinWidth="650"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Theme.WindowBackground}"
        Foreground="{DynamicResource Theme.TextPrimary}"
        FontFamily="{DynamicResource Theme.FontFamily}"
        FontSize="{DynamicResource Theme.FontSizeBase}"
        AutomationProperties.Name="Rule preview">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding RuleName}" FontSize="{DynamicResource Theme.FontSizeHeader}" FontWeight="SemiBold"/>
        <StackPanel Grid.Row="1" Margin="0,8,0,10">
            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding ActionDescription}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <ListView Grid.Row="2" ItemsSource="{Binding SampleMessages}" SelectionMode="Single">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="In/Out" DisplayMemberBinding="{Binding DirectionDisplay}" Width="65"/>
                    <GridViewColumn Header="From" DisplayMemberBinding="{Binding From}" Width="190"/>
                    <GridViewColumn Header="Subject" DisplayMemberBinding="{Binding Subject}" Width="280"/>
                    <GridViewColumn Header="Date" DisplayMemberBinding="{Binding DateDisplay}" Width="110"/>
                    <GridViewColumn Header="Folder" DisplayMemberBinding="{Binding FolderName}" Width="190"/>
                </GridView>
            </ListView.View>
        </ListView>

        <DockPanel Grid.Row="3" Margin="0,10,0,0" LastChildFill="False">
            <TextBlock Text="Showing at most 20 matching messages. No changes were made."
                       VerticalAlignment="Center" Foreground="{DynamicResource Theme.TextSecondary}"/>
            <Button Content="Close" IsCancel="True" MinWidth="80" Padding="10,4"
                    HorizontalAlignment="Right" DockPanel.Dock="Right"/>
        </DockPanel>
    </Grid>
</Window>
