<Window x:Class="QuickMail.Views.QuickMailProfileImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import a QuickMail Profile" Height="520" Width="720"
        MinHeight="480" MinWidth="620" WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        Background="{DynamicResource Theme.WindowBackground}"
        Foreground="{DynamicResource Theme.TextPrimary}"
        FontFamily="{DynamicResource Theme.FontFamily}"
        FontSize="{DynamicResource Theme.FontSizeBase}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Import a QuickMail profile" FontSize="{DynamicResource Theme.FontSizeHeader}"
                       FontWeight="SemiBold"/>
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                       Text="Eudora QuickMail creates an independent copy of the selected QuickMail profile. The source database, settings and files are never modified."/>
        </StackPanel>

        <GroupBox Grid.Row="1" Header="Existing QuickMail profile" Margin="0,0,0,12">
            <Grid Margin="12">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="SourceBox" MinHeight="30" VerticalContentAlignment="Center"
                         AutomationProperties.Name="Existing QuickMail profile folder"/>
                <Button Grid.Column="1" Margin="8,0,0,0" Padding="16,5" Content="Browse…"
                        Click="BrowseSource_Click"/>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="New Eudora QuickMail profile" Margin="0,0,0,12">
            <Grid Margin="12">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="DestinationBox" MinHeight="30" VerticalContentAlignment="Center"
                         AutomationProperties.Name="New Eudora QuickMail profile folder"/>
                <Button Grid.Column="1" Margin="8,0,0,0" Padding="16,5" Content="Browse…"
                        Click="BrowseDestination_Click"/>
            </Grid>
        </GroupBox>

        <CheckBox x:Name="StartOfflineCheckBox" Grid.Row="3" IsChecked="True" Margin="0,2,0,12"
                  Content="Start the imported profile offline so I can review its accounts first"
                  ToolTip="Recommended. Sending and receiving remain paused until you explicitly return online."/>

        <Border Grid.Row="4" Padding="14" Margin="0,0,0,16"
                BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="4">
            <StackPanel>
                <TextBlock Text="What is preserved" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock TextWrapping="Wrap"
                           Text="Cached mail and bodies, POP3 original messages, account definitions, contacts, groups, rules, views, templates, flags, shortcuts, custom themes and locally managed attachments."/>
                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Opacity="0.8"
                           Text="IMAP and Microsoft 365 attachment metadata is preserved. Attachment content that QuickMail did not cache remains available from the mail server. Saved credentials stay in Windows Credential Manager."/>
                <ProgressBar x:Name="ImportProgress" Margin="0,16,0,0" Height="8"
                             IsIndeterminate="True" Visibility="Collapsed"/>
                <TextBlock x:Name="StatusText" Margin="0,8,0,0" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="CancelButton" Grid.Column="1" Margin="0,0,8,0" Padding="18,7"
                    Content="Cancel" IsCancel="True"/>
            <Button x:Name="ImportButton" Grid.Column="2" Padding="18,7"
                    Content="Import QuickMail Profile" IsDefault="True" Click="Import_Click"/>
        </Grid>
    </Grid>
</Window>
