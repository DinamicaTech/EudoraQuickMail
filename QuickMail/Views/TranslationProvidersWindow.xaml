<Window x:Class="QuickMail.Views.TranslationProvidersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Translation Providers" Width="600" Height="500"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
  <Grid Margin="18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Default provider" FontWeight="SemiBold"/>
      <ComboBox x:Name="DefaultProviderBox" Width="220" HorizontalAlignment="Left" Margin="0,6,0,14">
        <ComboBoxItem Content="Argos Translate (local)" Tag="Argos"/>
        <ComboBoxItem Content="DeepL" Tag="DeepL"/>
      </ComboBox>
    </StackPanel>
    <TabControl Grid.Row="1">
      <TabItem Header="Argos Translate">
        <StackPanel Margin="14">
          <TextBlock TextWrapping="Wrap" Text="Argos runs entirely on this computer. It needs no account or API key. Install Argos Translate and the Spanish, Catalan and English language models separately."/>
          <TextBlock Text="Command or full executable path" Margin="0,14,0,4"/>
          <TextBox x:Name="ArgosCommandBox" Text="argos-translate"/>
          <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="Gray" Text="Typical setup: pip install argostranslate; then install the required .argosmodel packages. QuickMail never sends Argos text over the network."/>
          <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="Install / update runtime" Width="155" Click="InstallArgos_Click"/>
            <Button Content="Install ES/CA/EN models" Width="165" Margin="8,0,0,0" Click="InstallModels_Click"/>
            <Button Content="Test Argos" Width="95" Margin="8,0,0,0" Click="TestArgos_Click"/>
          </StackPanel>
        </StackPanel>
      </TabItem>
      <TabItem Header="DeepL">
        <StackPanel Margin="14">
          <TextBlock TextWrapping="Wrap" Text="DeepL sends the selected text to DeepL. The key is encrypted with Windows DPAPI and can only be decrypted by this Windows user. DeepL currently supports Spanish and English here; use Argos for Catalan."/>
          <TextBlock Text="API key" Margin="0,14,0,4"/>
          <PasswordBox x:Name="DeepLKeyBox"/>
          <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <Button Content="Save key" Width="95" Click="SaveKey_Click"/>
            <Button Content="Remove key" Width="100" Margin="8,0,0,0" Click="RemoveKey_Click"/>
            <Button Content="Test DeepL" Width="100" Margin="8,0,0,0" Click="TestDeepL_Click"/>
          </StackPanel>
        </StackPanel>
      </TabItem>
    </TabControl>
    <Grid Grid.Row="2" Margin="0,14,0,0">
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap"/>
      <Button Content="Close" Width="90" HorizontalAlignment="Right" Click="Close_Click"/>
    </Grid>
  </Grid>
</Window>
