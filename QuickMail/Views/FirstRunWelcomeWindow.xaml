<Window x:Class="QuickMail.Views.FirstRunWelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Eudora QuickMail" Height="850" Width="760"
        MinHeight="620" MinWidth="700" WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="True"
        Background="{DynamicResource Theme.WindowBackground}"
        Foreground="{DynamicResource Theme.TextPrimary}"
        FontFamily="{DynamicResource Theme.FontFamily}"
        FontSize="{DynamicResource Theme.FontSizeBase}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock x:Name="HeadingText" Text="Welcome to Eudora QuickMail" FontSize="{DynamicResource Theme.FontSizeHeader}" FontWeight="SemiBold"/>
            <TextBlock x:Name="IntroductionText" Margin="0,8,0,0" TextWrapping="Wrap"
                       Text="Eudora QuickMail can migrate your Eudora accounts, folders, messages, filters and referenced attachments now. Eudora should be closed during the import."/>
        </StackPanel>

        <GroupBox Grid.Row="1" Header="Eudora installation (bulk import) or Eudora Mailbox (selective import)" Margin="0,0,0,12">
            <Grid Margin="12">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="EudoraExeBox" MinHeight="30" VerticalContentAlignment="Center" IsReadOnly="True"
                         ToolTip="Select Eudora.exe for a complete import, or one or more .mbx/.fol items for a selective import."/>
                <Button Grid.Column="1" Margin="8,0,0,0" Padding="12,5" Content="EXE / Mailboxes…" Click="BrowseEudora_Click"/>
                <Button Grid.Column="2" Margin="8,0,0,0" Padding="12,5" Content=".fol folders…" Click="BrowseEudoraFolders_Click"/>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="Eudora QuickMail data folder" Margin="0,0,0,12">
            <Grid Margin="12">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="DataFolderBox" MinHeight="30" VerticalContentAlignment="Center"/>
                <Button Grid.Column="1" Margin="8,0,0,0" Padding="16,5" Content="Browse…" Click="BrowseData_Click"/>
            </Grid>
        </GroupBox>

        <GroupBox x:Name="FolderTreeGroup" Grid.Row="3" Header="Folder tree" Margin="0,0,0,12">
            <Grid Margin="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <TextBlock x:Name="RootNameLabel" VerticalAlignment="Center" Margin="0,0,12,0" Text="Root display name"/>
                <TextBox x:Name="RootNameBox" Grid.Column="1" Text="Eudora" MinHeight="30" VerticalContentAlignment="Center"
                         ToolTip="For a selective import, enter an existing or new path such as Customers/T-Innova. Missing folders in the path are created automatically."/>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="4" Header="Import options and attachments" Margin="0,0,0,18">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="12">
            <StackPanel>
                <CheckBox x:Name="ImportFiltersCheckBox" IsChecked="True" Margin="0,3"
                          Content="Import Eudora filters (filters.pce)"/>
                <TextBlock Margin="24,0,0,0" Opacity="0.75" TextWrapping="Wrap"
                           Text="Imports supported From, To, Subject and Body contains filters. Existing QuickMail rules are preserved and duplicates are not added."/>
                <CheckBox x:Name="RespectCheckMailSettingsCheckBox" IsChecked="False" Margin="0,11,0,3"
                          Content="Respect 'Check mail' settings for existing accounts"
                          ToolTip="Recommended off until you have reviewed the imported accounts, passwords and folders and are ready to put Eudora QuickMail into production. When off, automatic incoming-mail checks are disabled for every imported account."/>
                <Separator Margin="0,13,0,10"/>
                <RadioButton x:Name="KeepAttachments" IsChecked="True" Margin="0,3" Content="Keep them in their current Eudora folders"/>
                <TextBlock Margin="24,0,0,7" Opacity="0.75" TextWrapping="Wrap" Text="Uses no additional disk space. Eudora QuickMail keeps links to the existing files."/>
                <RadioButton x:Name="CopyAttachments" Margin="0,3" Content="Copy referenced attachments to the Eudora QuickMail data folder"/>
                <TextBlock Margin="24,0,0,7" Opacity="0.75" TextWrapping="Wrap" Text="Only files linked by an imported message are copied; orphan files are ignored. Additional disk space is required."/>
                <RadioButton x:Name="MoveAttachments" Margin="0,3" Content="Move referenced attachments to the Eudora QuickMail data folder"/>
                <TextBlock Margin="24,0,0,0" Foreground="{DynamicResource Theme.Error}" TextWrapping="Wrap" Text="Advanced option: Eudora will lose access to those attachments. Files are removed from Eudora only after a verified copy and a successful message import."/>
            </StackPanel>
            </ScrollViewer>
        </GroupBox>

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="WithoutEudoraButton" Grid.Column="1" Margin="0,0,8,0" Padding="18,7"
                    Content="Skip Eudora import (you can run it later from the Tools menu)"
                    Click="WithoutEudora_Click"/>
            <Button Grid.Column="2" Padding="18,7" Content="Import Eudora" IsDefault="True" Click="Import_Click"/>
        </Grid>
    </Grid>
</Window>
