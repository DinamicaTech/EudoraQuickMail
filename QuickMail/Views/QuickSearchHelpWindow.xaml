<Window x:Class="QuickMail.Views.QuickSearchHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Search Help" Width="680" Height="590" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Theme.WindowBackground}" Foreground="{DynamicResource Theme.TextPrimary}"
        FontFamily="{DynamicResource Theme.FontFamily}" FontSize="{DynamicResource Theme.FontSizeBase}">
  <Grid Margin="16">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock FontSize="{DynamicResource Theme.FontSizeHeader}" FontWeight="SemiBold" Text="Quick search syntax" Margin="0,0,0,10"/>
        <TextBlock TextWrapping="Wrap" Text="Separate criteria with semicolons; they are combined with AND. Put alternatives inside parentheses, separated with semicolons, to combine them with OR. Use double quotes to search punctuation such as a literal semicolon without interpreting it as syntax."/>
        <ItemsControl Margin="0,12" ItemsSource="{Binding}">
          <ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="65"/><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Prefix}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Description}"/><TextBlock Grid.Column="2" Text="{Binding Example}" FontFamily="Consolas"/></Grid></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock FontWeight="SemiBold" Text="Examples"/>
        <TextBlock FontFamily="Consolas" TextWrapping="Wrap" Margin="0,5,0,0"><Run Text="T:(@dinamica;@google);A#=2;D=3/5/2026"/><LineBreak/><Run Text="F:paypal;AN:invoice;D=03/2015"/><LineBreak/><Run Text="AC:cho?olate;D&gt;2025"/><LineBreak/><Run Text="&quot;text containing ; a semicolon&quot;"/></TextBlock>
        <TextBlock TextWrapping="Wrap" Margin="0,12,0,0" Text="Text fields use ':'; attachment counts and dates use =, &lt;, &lt;=, &gt; or &gt;=. Date values may be a complete local date, MM/yyyy, or yyyy. '?' matches exactly one character."/>
      </StackPanel>
    </ScrollViewer>
    <Button Grid.Row="1" Content="Close" IsDefault="True" IsCancel="True" Width="90" HorizontalAlignment="Right" Margin="0,12,0,0"/>
  </Grid>
</Window>
