                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="local:RowSpeech.Kind" Value="{x:Static models:RowKind.SenderGroup}"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>

                    <!-- To view: one root node per recipient, children are individual messages. -->
                    <TreeView x:Name="ToGroupTree"
                              AutomationProperties.Name="Messages"
                              ItemsSource="{Binding ToGroups}"
                              BorderThickness="0"
                              TabIndex="3"
                              KeyboardNavigation.TabNavigation="Once"
                              KeyboardNavigation.DirectionalNavigation="Contained"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True"
                              GotKeyboardFocus="ToGroupTree_GotKeyboardFocus"
                              SelectedItemChanged="ToGroupTree_SelectedItemChanged"
                              PreviewTextInput="ToGroupTree_PreviewTextInput"
                              PreviewKeyDown="ToGroupTree_PreviewKeyDown"
                              PreviewMouseRightButtonDown="ToGroupTree_PreviewMouseRightButtonDown"
                              ContextMenuOpening="ToGroupTree_ContextMenuOpening">
                        <TreeView.Style>
