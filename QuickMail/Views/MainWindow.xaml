            </Grid>
        </Grid>

        <!-- ── Status bar: current activity | selection and last download | local clock ── -->
        <StatusBar x:Name="MainStatusBar"
                   Grid.Row="3"
                   KeyboardNavigation.TabNavigation="None"
                   KeyboardNavigation.DirectionalNavigation="Contained"
                   HorizontalContentAlignment="Stretch"
                   AutomationProperties.Name="">
            <StatusBarItem Padding="0" HorizontalContentAlignment="Stretch"
                           KeyboardNavigation.IsTabStop="False"
                           Width="{Binding ActualWidth, ElementName=MainStatusBar}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="7*"/>
                        <ColumnDefinition Width="3*" MinWidth="260"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- About 70% of the bar: only the action currently in progress or its result. -->
                    <Border x:Name="StatusTextItem" Grid.Column="0" Padding="6,1"
                            BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                            BorderThickness="0,0,1,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStatusHighlighted}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Theme.AccentSubtle}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Theme.ErrorBackground}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <TextBlock x:Name="StatusTextBox"
                                       Focusable="True"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding StatusText, Mode=OneWay}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource StatusTextBlockStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Theme.Error}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ProgressBar x:Name="StatusProgressBar"
                                         Width="80" Height="12" HorizontalAlignment="Right"
                                         IsIndeterminate="True" Focusable="False"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                                         AutomationProperties.Name="{Binding StatusText, StringFormat='Working — {0}'}"/>
                        </Grid>
                    </Border>

                    <!-- Selection and the last completed incoming-mail download. -->
                    <Border Grid.Column="1" Padding="8,1"
                            BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                            BorderThickness="0,0,1,0">
                        <TextBlock TextAlignment="Right" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding SelectedMessageCount, StringFormat='Selected: {0:N0}'}"/>
                            <Run Text="{Binding LastSyncText, StringFormat='  ·  Last download: {0}'}"/>
                        </TextBlock>
                    </Border>

                    <!-- Current local date and time, always pinned to the far right. -->
                    <Border Grid.Column="2" Padding="8,1">
                        <TextBlock x:Name="StatusClockTextBlock" MinWidth="128" TextAlignment="Right"/>
                    </Border>
                </Grid>
            </StatusBarItem>
        </StatusBar>

        <!-- First-run keyboard tutorial overlay (topmost, covers everything when active) -->
        <local:TutorialOverlay x:Name="TutorialOverlayControl"
                               Grid.Row="0" Grid.RowSpan="4"
                               Panel.ZIndex="1000"/>
    </Grid>
</Window>
