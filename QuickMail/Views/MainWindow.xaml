<Window x:Class="QuickMail.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QuickMail.Views"
        xmlns:controls="clr-namespace:QuickMail.Controls"
        xmlns:models="clr-namespace:QuickMail.Models"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="650" Width="1000"
        MinHeight="400" MinWidth="700"
        Background="{DynamicResource Theme.WindowBackground}"
        Foreground="{DynamicResource Theme.TextPrimary}"
        FontFamily="{DynamicResource Theme.FontFamily}"
        FontSize="{DynamicResource Theme.FontSizeBase}">

    <Window.Resources>
        <local:BoolToFontWeightConverter x:Key="BoolToWeightConverter"/>
        <BooleanToVisibilityConverter    x:Key="BoolToVisibilityConverter"/>
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <local:BoolToGridLengthConverter        x:Key="BoolToGridLengthConverter"/>
        <local:StringToVisibilityConverter      x:Key="StringToVisibilityConverter"/>
        <local:StringToBrushConverter           x:Key="StringToBrushConverter"/>

        <!-- ── Shared context menus ── -->

        <!-- Sender-group context menu (root level of SenderGroupTree) -->
        <ContextMenu x:Key="SenderGroupContextMenu"
                     AutomationProperties.Name="Sender group actions"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="_Reply"
                      AutomationProperties.Name="Reply"
                      Command="{Binding ReplySenderGroupCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="Reply _All"
                      AutomationProperties.Name="Reply All"
                      Command="{Binding ReplyAllSenderGroupCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="_Forward"
                      AutomationProperties.Name="Forward"
                      Command="{Binding ForwardSenderGroupCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <Separator/>
            <MenuItem Header="_Move to Folder…"
                      AutomationProperties.Name="Move Sender Group to Folder"
                      Click="SenderGroupContextMenu_MoveToFolder_Click"/>
            <MenuItem Header="_Copy to Folder…"
                      AutomationProperties.Name="Copy Sender Group to Folder"
                      Click="SenderGroupContextMenu_CopyToFolder_Click"/>
            <Separator/>
            <MenuItem Header="_Delete All from Sender"
                      AutomationProperties.Name="Delete All from Sender"
                      Command="{Binding DeleteSenderGroupCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="A_rchive All from Sender"
                      AutomationProperties.Name="Archive All from Sender"
                      Command="{Binding ArchiveSenderGroupCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <Separator/>
            <MenuItem Header="Flag_s"
                      Tag="FlagsSubmenu"
                      AutomationProperties.Name="Flags"/>
            <Separator/>
            <MenuItem Header="E_xpand Group"
                      AutomationProperties.Name="Expand Group"
                      Command="{Binding ExpandSenderGroupCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="Colla_pse Group"
                      AutomationProperties.Name="Collapse Group"
                      Command="{Binding CollapseSenderGroupCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <Separator/>
            <MenuItem Header="_Expand All Groups"
                      AutomationProperties.Name="Expand All Groups"
                      Command="{Binding ExpandAllSenderGroupsCommand}"/>
            <MenuItem Header="Collapse A_ll Groups"
                      AutomationProperties.Name="Collapse All Groups"
                      Command="{Binding CollapseAllSenderGroupsCommand}"/>
        </ContextMenu>

        <ContextMenu x:Key="ToGroupContextMenu"
                     AutomationProperties.Name="Recipient group actions"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="_Reply"
                      AutomationProperties.Name="Reply"
                      Command="{Binding ReplyToGroupCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="Reply _All"
                      AutomationProperties.Name="Reply All"
                      Command="{Binding ReplyAllToGroupCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="_Forward"
                      AutomationProperties.Name="Forward"
                      Command="{Binding ForwardToGroupCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <Separator/>
            <MenuItem Header="_Move to Folder…"
                      AutomationProperties.Name="Move Recipient Group to Folder"
                      Click="ToGroupContextMenu_MoveToFolder_Click"/>
            <MenuItem Header="_Copy to Folder…"
                      AutomationProperties.Name="Copy Recipient Group to Folder"
                      Click="ToGroupContextMenu_CopyToFolder_Click"/>
            <Separator/>
            <MenuItem Header="_Delete All to Recipient"
                      AutomationProperties.Name="Delete All to Recipient"
                      Command="{Binding DeleteToGroupCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="A_rchive All to Recipient"
                      AutomationProperties.Name="Archive All to Recipient"
                      Command="{Binding ArchiveToGroupCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <Separator/>
            <MenuItem Header="Flag_s"
                      Tag="FlagsSubmenu"
                      AutomationProperties.Name="Flags"/>
            <Separator/>
            <MenuItem Header="E_xpand Group"
                      AutomationProperties.Name="Expand Group"
                      Command="{Binding ExpandToGroupCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="Colla_pse Group"
                      AutomationProperties.Name="Collapse Group"
                      Command="{Binding CollapseToGroupCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <Separator/>
            <MenuItem Header="_Expand All Groups"
                      AutomationProperties.Name="Expand All Groups"
                      Command="{Binding ExpandAllToGroupsCommand}"/>
            <MenuItem Header="Collapse A_ll Groups"
                      AutomationProperties.Name="Collapse All Groups"
                      Command="{Binding CollapseAllToGroupsCommand}"/>
        </ContextMenu>

        <!-- Conversation-group context menu (root level of ConversationTree) -->
        <ContextMenu x:Key="ConversationGroupContextMenu"
                     AutomationProperties.Name="Conversation actions"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="_Reply"
                      AutomationProperties.Name="Reply"
                      Command="{Binding ReplyConversationCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="Reply _All"
                      AutomationProperties.Name="Reply All"
                      Command="{Binding ReplyAllConversationCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="_Forward"
                      AutomationProperties.Name="Forward"
                      Command="{Binding ForwardConversationCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <Separator/>
            <MenuItem Header="_Move to Folder…"
                      AutomationProperties.Name="Move Conversation to Folder"
                      Click="ConversationContextMenu_MoveToFolder_Click"/>
            <MenuItem Header="_Copy to Folder…"
                      AutomationProperties.Name="Copy Conversation to Folder"
                      Click="ConversationContextMenu_CopyToFolder_Click"/>
            <Separator/>
            <MenuItem Header="_Delete Conversation"
                      AutomationProperties.Name="Delete Conversation"
                      Command="{Binding DeleteConversationCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="A_rchive Conversation"
                      AutomationProperties.Name="Archive Conversation"
                      Command="{Binding ArchiveConversationCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <Separator/>
            <MenuItem Header="Flag_s"
                      Tag="FlagsSubmenu"
                      AutomationProperties.Name="Flags"/>
            <Separator/>
            <MenuItem Header="E_xpand Conversation"
                      AutomationProperties.Name="Expand Conversation"
                      Command="{Binding ExpandConversationCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="Colla_pse Conversation"
                      AutomationProperties.Name="Collapse Conversation"
                      Command="{Binding CollapseConversationCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <Separator/>
            <MenuItem Header="_Expand All Conversations"
                      AutomationProperties.Name="Expand All Conversations"
                      Command="{Binding ExpandAllConversationsCommand}"/>
            <MenuItem Header="Collapse A_ll Conversations"
                      AutomationProperties.Name="Collapse All Conversations"
                      Command="{Binding CollapseAllConversationsCommand}"/>
        </ContextMenu>

        <!-- Individual-message context menu (MessageList and child nodes in ConversationTree) -->
        <ContextMenu x:Key="MessageContextMenu"
                     AutomationProperties.Name="Message actions"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="_Reply"
                      AutomationProperties.Name="Reply"
                      Command="{Binding ReplyCommand}"/>
            <MenuItem Header="Reply _All"
                      AutomationProperties.Name="Reply All"
                      Command="{Binding ReplyAllCommand}"/>
            <MenuItem Header="_Forward"
                      AutomationProperties.Name="Forward"
                      Command="{Binding ForwardCommand}"/>
            <MenuItem Header="Send _Again"
                      AutomationProperties.Name="Send again"
                      Command="{Binding SendAgainCommand}"/>
            <MenuItem Header="_History"
                      AutomationProperties.Name="Show message history with this contact"
                      Click="MessageContextMenu_History_Click"/>
            <Separator/>
            <MenuItem Header="Mark as _Read" Click="MessageContextMenu_MarkRead_Click"/>
            <MenuItem Header="Mark as _Unread" Click="MessageContextMenu_MarkUnread_Click"/>
            <MenuItem Header="Snoo_ze">
                <MenuItem Header="For 1 _hour" Tag="hour" Click="MessageContextMenu_Snooze_Click"/>
                <MenuItem Header="Until this _evening" Tag="evening" Click="MessageContextMenu_Snooze_Click"/>
                <MenuItem Header="Until _tomorrow morning" Tag="tomorrow" Click="MessageContextMenu_Snooze_Click"/>
                <MenuItem Header="Until next _week" Tag="week" Click="MessageContextMenu_Snooze_Click"/>
                <Separator/>
                <MenuItem Header="Choose date and _time…" Tag="custom" Click="MessageContextMenu_Snooze_Click"/>
            </MenuItem>
            <Separator/>
            <MenuItem Header="_Move to Folder…"
                      AutomationProperties.Name="Move to Folder"
                      Click="MessageContextMenu_MoveToFolder_Click"/>
            <MenuItem Header="_Copy to Folder…"
                      AutomationProperties.Name="Copy to Folder"
                      Click="MessageContextMenu_CopyToFolder_Click"/>
            <Separator/>
            <MenuItem Header="_Delete"
                      AutomationProperties.Name="Delete"
                      Click="MessageContextMenu_Delete_Click"/>
            <MenuItem Header="Move to _Archive"
                      InputGestureText="Ctrl+Shift+M"
                      AutomationProperties.Name="Move to Archive"
                      Click="MessageContextMenu_Archive_Click"/>
            <Separator/>
            <MenuItem Header="Flag_s"
                      Tag="FlagsSubmenu"
                      AutomationProperties.Name="Flags"/>
            <Separator/>
            <MenuItem Header="Create _Rule from Message…"
                      InputGestureText="Ctrl+Shift+F"
                      AutomationProperties.Name="Create Rule from Message"
                      AutomationProperties.AcceleratorKey="Ctrl+Shift+F"
                      Command="{Binding CreateRuleFromMessageCommand}"/>
            <MenuItem Header="Filter _All Like This"
                      InputGestureText="Ctrl+Shift+A"
                      AutomationProperties.Name="Filter all like this"
                      AutomationProperties.AcceleratorKey="Ctrl+Shift+A"
                      Command="{Binding FilterAllLikeThisCommand}"/>
            <Separator/>
            <MenuItem Header="View _Source"
                      AutomationProperties.Name="View message source"
                      Click="MessageContextMenu_ViewSource_Click"/>
            <MenuItem Header="E_xport"
                      AutomationProperties.Name="Export message">
                <MenuItem Header="Save as _EML…" Click="MessageContextMenu_SaveEml_Click"/>
                <MenuItem Header="Save as _HTML…" Click="MessageContextMenu_SaveHtml_Click"/>
                <Separator/>
                <MenuItem Header="Copy Message _Headers" Click="MessageContextMenu_CopyHeaders_Click"/>
            </MenuItem>
        </ContextMenu>

        <!-- Folder context menu — MUST live in Window.Resources, not inside a Style.Setter.Value.
             The WPF XAML compiler generates incorrect type casts for Click handlers inside
             Style setters (it emits GridSplitter instead of MenuItem), causing an APPCRASH. -->
        <ContextMenu x:Key="FolderContextMenu"
                     AutomationProperties.Name="Folder actions">
            <MenuItem Header="_New Folder…"
                      AutomationProperties.Name="New Folder"
                      Click="FolderContextMenu_NewFolder_Click"/>
            <Separator/>
            <MenuItem Header="Mark as _Read"
                      AutomationProperties.Name="Mark all messages in this folder and subfolders as read"
                      Click="FolderContextMenu_MarkRead_Click"/>
            <MenuItem Header="_Filters…"
                      AutomationProperties.Name="Show filters that move messages to this folder"
                      Click="FolderContextMenu_Filters_Click"/>
            <Separator/>
            <MenuItem Header="R_ename Folder…"
                      InputGestureText="F2"
                      AutomationProperties.Name="Rename Folder"
                      Click="FolderContextMenu_RenameFolder_Click"/>
            <MenuItem Header="_Move Folder…"
                      AutomationProperties.Name="Move Folder"
                      Click="FolderContextMenu_MoveFolder_Click"/>
            <MenuItem Header="_Copy Folder…"
                      AutomationProperties.Name="Copy Folder"
                      Click="FolderContextMenu_CopyFolder_Click"/>
            <Separator/>
            <MenuItem Header="Set as _Archive Folder"
                      AutomationProperties.Name="Set as Archive Folder"
                      Click="FolderContextMenu_SetArchive_Click"/>
            <MenuItem Header="Use A_utomatic Archive Folder"
                      AutomationProperties.Name="Use Automatic Archive Folder"
                      Click="FolderContextMenu_ClearArchive_Click"/>
            <Separator/>
            <!-- #516. N, M, C, A, U and D are taken by the items above — note U, from "Use A_utomatic
                 Archive Folder" — leaving S and F. WPF cycles between duplicate access keys instead
                 of invoking, so a collision here would make the key highlight rather than activate. -->
            <MenuItem Header="Set as _Startup Folder"
                      AutomationProperties.Name="Set as Startup Folder"
                      Click="FolderContextMenu_SetStartupFolder_Click"/>
            <MenuItem Header="Clear Startup _Folder"
                      AutomationProperties.Name="Clear Startup Folder"
                      Click="FolderContextMenu_ClearStartupFolder_Click"/>
            <Separator/>
            <MenuItem Header="_Delete Folder"
                      AutomationProperties.Name="Delete Folder"
                      Click="FolderContextMenu_DeleteFolder_Click"/>
        </ContextMenu>

        <!-- Calendar context menu — replaces FolderContextMenu on the Calendar node and its
             children (issue #497). None of the mail folder actions apply to a calendar; every one
             of them silently did nothing there. Same Window.Resources rule as above: a ContextMenu
             with Click handlers must not be declared inside a Style setter. -->
        <ContextMenu x:Key="CalendarContextMenu"
                     AutomationProperties.Name="Calendar actions">
            <MenuItem Header="Use as _Default Calendar for New Appointments"
                      AutomationProperties.Name="Use as Default Calendar for New Appointments"
                      Click="CalendarContextMenu_SetDefault_Click"/>
            <MenuItem Header="_Clear Default Calendar"
                      AutomationProperties.Name="Clear Default Calendar"
                      Click="CalendarContextMenu_ClearDefault_Click"/>
        </ContextMenu>
    </Window.Resources>

    <Window.InputBindings>
        <!-- Navigation shortcuts not in the command registry are handled directly in PreviewKeyDown. -->
        <!-- Action command shortcuts are routed through the CommandRegistry in OnWindowKeyDown.     -->
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Menu bar -->
            <RowDefinition Height="0"/>     <!-- Toolbar now belongs to the message-list pane -->
            <RowDefinition Height="*"/>     <!-- Content -->
            <RowDefinition Height="Auto"/>  <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ── Menu bar — Row 0 ── -->
        <Menu x:Name="MainMenuBar"
              Grid.Row="0"
              IsTabStop="False"
              KeyboardNavigation.TabNavigation="None"
              AutomationProperties.Name="Main menu">

            <!-- File -->
            <MenuItem Header="_File">
                <MenuItem Header="_New Message"
                          Command="{Binding NewMessageCommand}"
                          InputGestureText="Ctrl+N"/>
                <Separator/>
                <MenuItem Header="_Manage Accounts…"
                          Command="{Binding ManageAccountsCommand}"/>
                <MenuItem Header="_Import from Eudora…"
                          Click="MenuImportEudora_Click"/>
                <Separator/>
                <MenuItem Header="S_ettings…"
                          Click="MenuSettings_Click"
                          InputGestureText="Ctrl+,"/>
                <Separator/>
                <MenuItem Header="E_xit"
                          Command="{Binding ExitCommand}"/>
            </MenuItem>

            <!-- Message -->
            <MenuItem Header="_Message" SubmenuOpened="MessageMenu_SubmenuOpened">
                <MenuItem Header="_Search…" InputGestureText="F3" Click="MenuSearch_Click"/>
                <Separator/>
                <MenuItem Header="_Reply"
                          Command="{Binding ReplyCommand}"
                          InputGestureText="Ctrl+R"/>
                <MenuItem Header="Reply _All"
                          Command="{Binding ReplyAllCommand}"
                          InputGestureText="Ctrl+Shift+R"/>
                <MenuItem Header="_Forward"
                          Command="{Binding ForwardCommand}"
                          InputGestureText="Ctrl+F"/>
                <Separator/>
                <MenuItem Header="_Delete"
                          Command="{Binding DeleteMessageCommand}"
                          InputGestureText="Del"/>
                <MenuItem Header="Move to _Archive"
                          Command="{Binding ArchiveMessageCommand}"
                          InputGestureText="Ctrl+Shift+M"/>
                <Separator/>
                <!-- Click, not Command: the target depends on which group tree is selected, which
                     only the window can resolve (see WatchTargetSubject). Dimmed rather than
                     disabled, per the convention above, so it stays keyboard-navigable. -->
                <MenuItem Header="_Watch Conversation"
                          IsCheckable="True"
                          IsChecked="{Binding IsWatchTargetWatched, Mode=OneWay}"
                          Click="MenuWatchConversation_Click"
                          InputGestureText="Ctrl+Shift+W">
                    <MenuItem.Style>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasWatchTarget}" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource Theme.TextDisabled}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </MenuItem.Style>
                </MenuItem>
                <Separator/>
                <!-- Keep IsEnabled off these three items so they remain keyboard-navigable
                     per Windows convention (dimmed items are still focusable). Visual dimming
                     is applied via DataTrigger; the Click handlers guard against invalid state. -->
                <MenuItem Header="_Move to Folder…"
                          Click="MenuMoveToFolder_Click">
                    <MenuItem.Style>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelectedMessage}" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource Theme.TextDisabled}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </MenuItem.Style>
                </MenuItem>
                <MenuItem Header="_Copy to Folder…"
                          Click="MenuCopyToFolder_Click">
                    <MenuItem.Style>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelectedMessage}" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource Theme.TextDisabled}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </MenuItem.Style>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Grab _Addresses from Message"
                          Click="MenuGrabAddresses_Click"
                          InputGestureText="Ctrl+Shift+G">
                    <MenuItem.Style>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMessageOpen}" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource Theme.TextDisabled}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </MenuItem.Style>
                </MenuItem>
            </MenuItem>

            <!-- Folder -->
            <MenuItem Header="Fol_der">
                <MenuItem Header="_New Folder…"
                          Click="MenuNewFolder_Click"
                          AutomationProperties.Name="New Folder"/>
            </MenuItem>

            <!-- View -->
            <MenuItem Header="_View">
                <MenuItem Header="_Refresh"
                          Command="{Binding RefreshCommand}"
                          InputGestureText="F5"/>
                <Separator/>
                <MenuItem Header="_Plain Text View"
                          IsCheckable="True"
                          IsChecked="{Binding ReadAsPlainText, Mode=OneWay}"
                          Click="MenuPlainText_Click"
                          InputGestureText="Ctrl+Shift+H"/>
                <Separator/>
                <MenuItem Header="View _Mode">
                    <!-- Mail view modes — hidden while the calendar is open. -->
                    <MenuItem Header="_Messages"
                              Visibility="{Binding IsCalendarView, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                              IsCheckable="True"
                              IsChecked="{Binding IsMessagesView, Mode=OneWay}"
                              Command="{Binding SetViewModeCommand}"
                              CommandParameter="Messages"/>
                    <MenuItem Header="_Conversations"
                              Visibility="{Binding IsCalendarView, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                              IsCheckable="True"
                              IsChecked="{Binding IsConversationsView, Mode=OneWay}"
                              Command="{Binding SetViewModeCommand}"
                              CommandParameter="Conversations"/>
                    <MenuItem Header="By _Sender"
                              Visibility="{Binding IsCalendarView, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                              IsCheckable="True"
                              IsChecked="{Binding IsFromView, Mode=OneWay}"
                              Command="{Binding SetViewModeCommand}"
                              CommandParameter="From"/>
                    <MenuItem Header="By _Recipient"
                              Visibility="{Binding IsCalendarView, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                              IsCheckable="True"
                              IsChecked="{Binding IsToView, Mode=OneWay}"
                              Command="{Binding SetViewModeCommand}"
                              CommandParameter="To"/>
                    <!-- Calendar view modes — shown only while the calendar is open. -->
                    <MenuItem Header="_Agenda"
                              Visibility="{Binding IsCalendarView, Converter={StaticResource BoolToVisibilityConverter}}"
                              IsCheckable="True"
                              IsChecked="{Binding CalendarVm.IsAgendaView, Mode=OneWay}"
                              Command="{Binding CalendarVm.ShowAgendaCommand}"/>
                    <MenuItem Header="_Day"
                              Visibility="{Binding IsCalendarView, Converter={StaticResource BoolToVisibilityConverter}}"
                              IsCheckable="True"
                              IsChecked="{Binding CalendarVm.IsDayView, Mode=OneWay}"
                              Command="{Binding CalendarVm.ShowDayCommand}"/>
                    <MenuItem Header="_Week"
                              Visibility="{Binding IsCalendarView, Converter={StaticResource BoolToVisibilityConverter}}"
                              IsCheckable="True"
                              IsChecked="{Binding CalendarVm.IsWeekView, Mode=OneWay}"
                              Command="{Binding CalendarVm.ShowWeekCommand}"/>
                    <MenuItem Header="M_onth"
                              Visibility="{Binding IsCalendarView, Converter={StaticResource BoolToVisibilityConverter}}"
                              IsCheckable="True"
                              IsChecked="{Binding CalendarVm.IsMonthView, Mode=OneWay}"
                              Command="{Binding CalendarVm.ShowMonthCommand}"/>
                </MenuItem>
                <!-- Density (#421): the same setting as Settings → Appearance,
                     adjustable in place. Padding only — never the accessibility
                     surface. Registered as view.density.* for palette/hotkeys. -->
                <MenuItem Header="_Density">
                    <MenuItem Header="_Comfortable"
                              IsCheckable="True"
                              IsChecked="{Binding IsListDensityComfortable, Mode=OneWay}"
                              Command="{Binding SetListDensityCommand}"
                              CommandParameter="comfortable"/>
                    <MenuItem Header="Co_mpact"
                              IsCheckable="True"
                              IsChecked="{Binding IsListDensityCompact, Mode=OneWay}"
                              Command="{Binding SetListDensityCommand}"
                              CommandParameter="compact"/>
                </MenuItem>
                <!-- Which fields each kind of list row speaks, and in what order.
                     Registered as view.rowFields; opened modeless. -->
                <MenuItem x:Name="RowFieldsMenuItem"
                          Header="Message List Fi_elds…"/>
                <MenuItem Header="F_ilter">
                    <MenuItem Header="S_how All"
                              IsCheckable="True"
                              IsChecked="{Binding IsFilterAll, Mode=OneWay}"
                              Command="{Binding SetFilterCommand}"
                              CommandParameter="all"/>
                    <Separator/>
                    <MenuItem Header="_Unread"
                              IsCheckable="True"
                              IsChecked="{Binding IsFilterUnread, Mode=OneWay}"
                              Command="{Binding SetFilterCommand}"
                              CommandParameter="unread"/>
                    <MenuItem Header="_Read"
                              IsCheckable="True"
                              IsChecked="{Binding IsFilterRead, Mode=OneWay}"
                              Command="{Binding SetFilterCommand}"
                              CommandParameter="read"/>
                    <Separator/>
                    <MenuItem Header="With _Attachments"
                              IsCheckable="True"
                              IsChecked="{Binding IsFilterWithAttachments, Mode=OneWay}"
                              Command="{Binding SetFilterCommand}"
                              CommandParameter="attachments"/>
                    <MenuItem Header="Re_plied"
                              IsCheckable="True"
                              IsChecked="{Binding IsFilterReplied, Mode=OneWay}"
                              Command="{Binding SetFilterCommand}"
                              CommandParameter="replied"/>
                    <MenuItem Header="_Forwarded"
                              IsCheckable="True"
                              IsChecked="{Binding IsFilterForwarded, Mode=OneWay}"
                              Command="{Binding SetFilterCommand}"
                              CommandParameter="forwarded"/>
                    <Separator/>
                    <MenuItem Header="To _Me"
                              IsCheckable="True"
                              IsChecked="{Binding IsFilterToMe, Mode=OneWay}"
                              Command="{Binding SetFilterCommand}"
                              CommandParameter="tome"/>
                    <MenuItem Header="_Watched"
                              IsCheckable="True"
                              IsChecked="{Binding IsFilterWatched, Mode=OneWay}"
                              Command="{Binding SetFilterCommand}"
                              CommandParameter="watched"/>
                    <Separator/>
                    <MenuItem x:Name="FilterFlaggedItem"
                              Header="Fla_gged"
                              IsChecked="{Binding IsFilterFlagged, Mode=OneWay}">
                        <MenuItem Header="All Fla_gged"
                                  IsCheckable="True"
                                  IsChecked="{Binding IsFilterAllFlagged, Mode=OneWay}"
                                  Command="{Binding SetFilterCommand}"
                                  CommandParameter="flagged"/>
                        <Separator x:Name="FilterFlaggedSeparator"/>
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="S_ort">
                    <MenuItem Header="Newest _First"
                              IsCheckable="True"
                              IsChecked="{Binding IsSortDateDesc, Mode=OneWay}"
                              Command="{Binding SetSortCommand}"
                              CommandParameter="dateDesc"/>
                    <MenuItem Header="_Oldest First"
                              IsCheckable="True"
                              IsChecked="{Binding IsSortDateAsc, Mode=OneWay}"
                              Command="{Binding SetSortCommand}"
                              CommandParameter="dateAsc"/>
                    <Separator/>
                    <MenuItem Header="_A → Z"
                              IsCheckable="True"
                              IsChecked="{Binding IsSortAlphaAsc, Mode=OneWay}"
                              Command="{Binding SetSortCommand}"
                              CommandParameter="alphaAsc"/>
                    <MenuItem Header="_Z → A"
                              IsCheckable="True"
                              IsChecked="{Binding IsSortAlphaDesc, Mode=OneWay}"
                              Command="{Binding SetSortCommand}"
                              CommandParameter="alphaDesc"/>
                    <Separator/>
                    <MenuItem Header="Fla_gged First"
                              IsCheckable="True"
                              IsChecked="{Binding IsSortFlaggedFirst, Mode=OneWay}"
                              Command="{Binding SetSortCommand}"
                              CommandParameter="flaggedFirst"/>
                    <Separator/>
                    <MenuItem Header="_Most Messages"
                              IsCheckable="True"
                              IsChecked="{Binding IsSortCountDesc, Mode=OneWay}"
                              IsEnabled="{Binding IsCountSortAvailable}"
                              Command="{Binding SetSortCommand}"
                              CommandParameter="countDesc"/>
                    <MenuItem Header="_Fewest Messages"
                              IsCheckable="True"
                              IsChecked="{Binding IsSortCountAsc, Mode=OneWay}"
                              IsEnabled="{Binding IsCountSortAvailable}"
                              Command="{Binding SetSortCommand}"
                              CommandParameter="countAsc"/>
                </MenuItem>
                <MenuItem Header="_Views" x:Name="ViewsMenuItem">
                    <!-- Dynamic view items inserted by code-behind -->
                    <Separator x:Name="ViewsMenuSeparator" Visibility="Collapsed"/>
                    <MenuItem Header="_Save View…"
                              Command="{Binding SaveViewCommand}"
                              AutomationProperties.Name="Save current state as a view"/>
                    <MenuItem Header="_Manage Views…"
                              Command="{Binding ManageViewsCommand}"
                              AutomationProperties.Name="Open View Manager"/>
                    <MenuItem Header="_Clear View"
                              Command="{Binding ClearViewCommand}"
                              AutomationProperties.Name="Clear View"/>
                    <MenuItem Header="_Reset Folder View"
                              Command="{Binding ResetFolderViewCommand}"
                              AutomationProperties.Name="Reset Folder View"/>
                </MenuItem>
                <MenuItem Header="_Sync Range">
                    <MenuItem Header="Last _7 Days"
                              IsCheckable="True"
                              IsChecked="{Binding IsSyncDays7, Mode=OneWay}"
                              Command="{Binding SetSyncDaysCommand}"
                              CommandParameter="7"/>
                    <MenuItem Header="Last _30 Days"
                              IsCheckable="True"
                              IsChecked="{Binding IsSyncDays30, Mode=OneWay}"
                              Command="{Binding SetSyncDaysCommand}"
                              CommandParameter="30"/>
                    <MenuItem Header="Last _6 Months"
                              IsCheckable="True"
                              IsChecked="{Binding IsSyncDays180, Mode=OneWay}"
                              Command="{Binding SetSyncDaysCommand}"
                              CommandParameter="180"/>
                    <MenuItem Header="Last _1 Year"
                              IsCheckable="True"
                              IsChecked="{Binding IsSyncDays365, Mode=OneWay}"
                              Command="{Binding SetSyncDaysCommand}"
                              CommandParameter="365"/>
                    <Separator/>
                    <MenuItem Header="_All Mail"
                              IsCheckable="True"
                              IsChecked="{Binding IsSyncDaysAll, Mode=OneWay}"
                              Command="{Binding SetSyncDaysCommand}"
                              CommandParameter="0"/>
                </MenuItem>
                <Separator/>
                <!-- Moved from Tools: choosing how the app looks belongs on View.
                     Next/Previous Theme remain palette commands (theme.next/previous)
                     without menu items, per design. -->
                <MenuItem Header="Manage _Themes…"
                          Click="MenuManageThemes_Click"
                          AutomationProperties.Name="Manage Themes"/>
                <Separator/>
                <MenuItem Header="Go to _Folder…"
                          Click="MenuFolderPicker_Click"/>
                <MenuItem Header="_Search Folders…"
                          Click="MenuSearchFolders_Click"/>
            </MenuItem>

            <!-- Tools — always available (mirrors the Compose window's Tools menu).
                 Each command lives here only; not duplicated in File/Message/View. -->
            <MenuItem Header="_Tools">
                <MenuItem x:Name="OfflineModeMenuItem" Header="Work _Offline"
                          IsCheckable="True" Click="OfflineModeMenuItem_Click"/>
                <MenuItem Header="_Focus Mode">
                    <MenuItem Header="15 minutes" Tag="15" Click="FocusModeMenuItem_Click"/>
                    <MenuItem Header="30 minutes" Tag="30" Click="FocusModeMenuItem_Click"/>
                    <MenuItem Header="1 hour" Tag="60" Click="FocusModeMenuItem_Click"/>
                    <MenuItem Header="2 hours" Tag="120" Click="FocusModeMenuItem_Click"/>
                    <Separator/>
                    <MenuItem x:Name="EndFocusModeMenuItem" Header="End Focus Mode"
                              Click="EndFocusModeMenuItem_Click"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Address _Book…"
                          Click="MenuAddressBook_Click"
                          InputGestureText="Ctrl+Shift+B"/>
                <MenuItem Header="_Rules…"
                          Command="{Binding OpenRulesManagerCommand}"
                          InputGestureText="Ctrl+Shift+L"
                          AutomationProperties.Name="Manage Rules"
                          AutomationProperties.AcceleratorKey="Ctrl+Shift+L"/>
                <!-- The manager belongs here with the other managers, not beside Watch
                     Conversation on the Message menu: that one acts on the selected message,
                     this one is a surface for reviewing what you have accumulated. Same split
                     as toggling a flag versus managing flags. -->
                <MenuItem Header="_Watched Conversations…"
                          Click="MenuWatchedConversations_Click"
                          AutomationProperties.Name="Watched Conversations"/>
                <MenuItem Header="_Analyze Folder…"
                          Click="MenuAnalyzeFolder_Click"
                          AutomationProperties.Name="Analyze Folder"/>
                <MenuItem Header="Account _Health…"
                          Click="MenuAccountHealth_Click"
                          AutomationProperties.Name="Account Health"/>
                <Separator/>
                <MenuItem Header="Recalculate _Folder Counts"
                          Click="MenuRecalculateFolderCounts_Click"
                          AutomationProperties.Name="Recalculate Folder Counts"/>
                <MenuItem Header="_Rebuild Search Indexes…"
                          Click="MenuRebuildSearchIndexes_Click"
                          AutomationProperties.Name="Rebuild Search Indexes"/>
                <MenuItem Header="_Update Attachment Index"
                          Click="MenuUpdateAttachmentIndex_Click"/>
                <MenuItem Header="Delete _Orphaned Attachments…"
                          Click="MenuDeleteOrphanedAttachments_Click"/>
                <MenuItem Header="Deduplicate _Embedded Resources…"
                          Click="MenuDeduplicateEmbeddedResources_Click"/>
                <MenuItem Header="Empty _Trash"
                          Command="{Binding EmptyTrashCommand}"
                          InputGestureText="Ctrl+Shift+E"/>
                <Separator/>
                <MenuItem Header="Command _Palette…"
                          Click="MenuCommandPalette_Click"
                          InputGestureText="Ctrl+Shift+P"/>
            </MenuItem>

            <!-- Help -->
            <MenuItem Header="_Help">
                <MenuItem Header="{Binding UpdateAvailableText, Mode=OneWay}"
                          Command="{Binding OpenUpdatePageCommand}"/>
                <!-- Only on an ARM64 PC running the x64 build: nothing migrates an install
                     across architectures, so this entry is how those users find the native
                     build. Hidden everywhere else. -->
                <MenuItem Header="Get the _ARM Version"
                          AutomationProperties.Name="Get the ARM Version"
                          Visibility="{Binding IsNativeArmAvailable, Converter={StaticResource BoolToVisibilityConverter}}"
                          Command="{Binding OpenArmDownloadPageCommand}"/>
                <Separator/>
                <MenuItem Header="User _Guide"
                          Command="{Binding ViewUserGuideCommand}"
                          InputGestureText="F1"/>
                <MenuItem Header="_Keyboard Tutorial"
                          AutomationProperties.Name="Keyboard Tutorial"
                          Click="MenuKeyboardTutorial_Click"/>
                <Separator/>
                <MenuItem Header="_Report a Bug"
                          AutomationProperties.Name="Report a Bug"
                          Click="MenuReportBug_Click"/>
                <MenuItem Header="Connection _Diagnostics"
                          AutomationProperties.Name="Connection Diagnostics"
                          Visibility="{Binding IsConnectionDiagnosticsEnabled, Converter={StaticResource BoolToVisibilityConverter}}"
                          Click="MenuConnectionDiagnostics_Click"/>
                <Separator/>
                <MenuItem Header="_About Eudora QuickMail"
                          AutomationProperties.Name="About Eudora QuickMail"
                          Click="MenuAbout_Click"/>
            </MenuItem>

        </Menu>

        <!-- ── Three-pane layout (Outlook-style): Accounts+Folders left | Messages right ── -->
        <!--  F6 pane ring: AccountList(1) → FolderList(2) → MessageList(3) → Toolbar → StatusBar → wrap -->
        <!--  Arrow keys navigate within the focused pane (TabNavigation=Once on each)      -->
        <!--  Enter triggers action; focus never changes unless user does it                 -->
        <!--  Ctrl+0 = Sent/Outbox | Ctrl+1 = Inbox; Ctrl+Alt+1/2/3 = pane navigation       -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FolderPaneColumn" Width="200" MinWidth="120"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- Left pane: Accounts on top, Folders below -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition x:Name="AccountPaneRow" Height="*" MinHeight="60"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition x:Name="TodayAgendaRow" Height="190" MinHeight="80"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2*" MinHeight="80"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="AccountsHeader" Grid.Row="0" Text="Accounts" FontWeight="SemiBold" Padding="6,4"
                           Focusable="False"
                           Background="{DynamicResource Theme.ChromeBackground}"/>

                <DockPanel x:Name="AccountsPanel" Grid.Row="1">
                <Button DockPanel.Dock="Top" Content="(All messages)" HorizontalContentAlignment="Left"
                        Padding="6,5" Click="AllMessagesAccount_Click"
                        AutomationProperties.Name="All messages from every account"/>
                <ListBox
                         x:Name="AccountList"
                         AutomationProperties.Name="Email accounts"
                         ItemsSource="{Binding Accounts}"
                         SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                         TextSearch.TextPath="AccountLabel"
                         BorderThickness="0,0,1,0"
                         TabIndex="1"
                         KeyboardNavigation.TabNavigation="Once"
                         GotKeyboardFocus="List_GotKeyboardFocus"
                         PreviewKeyDown="AccountList_PreviewKeyDown">

                    <!-- Two-line item: account name + live status (connected/disconnected + inbox counts).
                         AutomationProperties.Name on the container announces the full detail to screen
                         readers on focus, without requiring the user to hover over the tooltip. -->
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
                            <Setter Property="Padding"                   Value="4,4,4,4"/>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- AriaHiddenTextBlock suppresses both child elements from the UIA tree.
                                 The full accessible name is on the ListBoxItem container via
                                 AutomationProperties.Name → AccessibleName, so screen readers
                                 read it once only. -->
                            <StackPanel>
                                <local:AriaHiddenTextBlock Text="{Binding AccountLabel}"/>
                                <!-- Opacity, not Theme.TextSecondary: inherits the container foreground,
                                     so the line stays readable over the strong selection fill. -->
                                <local:AriaHiddenTextBlock Text="{Binding StatusLabel}"
                                                           Opacity="0.75"
                                                           FontSize="{DynamicResource Theme.FontSizeSmall}"
                                                           Margin="0,1,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                    <ListBox.ContextMenu>
                        <ContextMenu AutomationProperties.Name="Account actions">
                            <MenuItem Header="_Delete Account"
                                      AutomationProperties.Name="Delete Account"
                                      Command="{Binding PlacementTarget.DataContext.DeleteAccountCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="Account _Settings…"
                                      AutomationProperties.Name="Account Settings"
                                      Command="{Binding PlacementTarget.DataContext.OpenAccountSettingsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
                </DockPanel>

                <GridSplitter x:Name="AccountsSplitter" Grid.Row="2" Height="5" HorizontalAlignment="Stretch"
                              ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                              DragCompleted="PaneSplitter_DragCompleted"/>

                <DockPanel x:Name="TodayAgendaHeader" Grid.Row="3" LastChildFill="True"
                           Background="{DynamicResource Theme.ChromeBackground}">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="+" Width="26" Padding="2,0" ToolTip="New appointment"
                                Click="TodayAgendaNew_Click" AutomationProperties.Name="New appointment"/>
                        <Button Content="↻" Width="26" Padding="2,0" ToolTip="Refresh today"
                                Click="TodayAgendaRefresh_Click" AutomationProperties.Name="Refresh today's agenda"/>
                    </StackPanel>
                    <ComboBox DockPanel.Dock="Right" Width="145" Margin="4,2"
                              ItemsSource="{Binding CalendarVm.SourceChoices}"
                              SelectedItem="{Binding CalendarVm.SelectedSource, Mode=TwoWay}"
                              DisplayMemberPath="Label"
                              ToolTip="Choose which calendar is shown"
                              AutomationProperties.Name="Calendar source"/>
                    <TextBlock Text="{Binding CalendarVm.TodayAgendaTitle}" FontWeight="SemiBold" Padding="6,4"/>
                </DockPanel>

                <Grid x:Name="TodayAgendaPanel" Grid.Row="4">
                    <TextBlock x:Name="TodayAgendaEmptyText"
                               Text="No appointments today. Click + to schedule an appointment."
                               TextWrapping="Wrap" TextAlignment="Center" Margin="8"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Panel.ZIndex="1" MouseLeftButtonUp="TodayAgendaEmptyText_MouseLeftButtonUp"
                               Foreground="{DynamicResource Theme.TextSecondary}"
                               Visibility="{Binding CalendarVm.HasTodayEvents, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                    <ListBox x:Name="TodayAgendaList"
                             ItemsSource="{Binding CalendarVm.TodayEvents}"
                             SelectedItem="{Binding CalendarVm.SelectedEvent, Mode=TwoWay}"
                             BorderThickness="0,0,1,0"
                             MouseDoubleClick="TodayAgendaList_MouseDoubleClick"
                             AutomationProperties.Name="Today's appointments">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="3,2" Padding="6,3" CornerRadius="4"
                                        Background="{DynamicResource Theme.Success}"
                                        ToolTip="{Binding DetailText}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding CompactTimeDisplay}" MinWidth="72" Margin="0,0,6,0"
                                                   Foreground="{DynamicResource Theme.TextOnAccent}"
                                                   FontWeight="SemiBold"
                                                   FontSize="{DynamicResource Theme.FontSizeSmall}"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource Theme.TextOnAccent}"/>
                                            <TextBlock Text="{Binding Location}" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource Theme.TextOnAccent}"
                                                       Opacity="0.85"
                                                       FontSize="{DynamicResource Theme.FontSizeSmall}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <GridSplitter x:Name="TodayAgendaSplitter" Grid.Row="5" Height="5" HorizontalAlignment="Stretch"
                              ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                              DragCompleted="PaneSplitter_DragCompleted"/>

                <TextBlock Grid.Row="6" Text="Folders" FontWeight="SemiBold" Padding="6,4"
                           Focusable="False"
                           Background="{DynamicResource Theme.ChromeBackground}"/>

                <!-- True TreeView so screen readers announce level, expanded/collapsed state correctly. -->
                <TreeView Grid.Row="7"
                          x:Name="FolderList"
                          AutomationProperties.Name="Folder list"
                          ItemsSource="{Binding FolderTree}"
                          BorderThickness="0,0,1,0"
                          TabIndex="2"
                          KeyboardNavigation.TabNavigation="Once"
                          GotKeyboardFocus="FolderList_GotKeyboardFocus"
                          AllowDrop="True"
                          DragOver="FolderList_DragOver"
                          Drop="FolderList_Drop"
                          PreviewTextInput="FolderList_PreviewTextInput"
                          PreviewKeyDown="FolderList_PreviewKeyDown"
                          PreviewMouseLeftButtonDown="FolderList_PreviewMouseLeftButtonDown"
                          PreviewMouseLeftButtonUp="FolderList_PreviewMouseLeftButtonUp"
                          PreviewMouseMove="FolderList_PreviewMouseMove"
                          SelectedItemChanged="FolderList_SelectedItemChanged">
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type models:FolderTreeNode}"
                                                  ItemsSource="{Binding Children}">
                            <!-- Visual display only. The TreeViewItem container carries the
                                 accessible name (AutomationProperties.Name → AutomationName)
                                 and unread count (AutomationProperties.ItemStatus →
                                 ItemStatusLabel). Splitting name and count across two UIA
                                 properties prevents JAWS from announcing the count twice
                                 (once per automation peer). -->
                            <StackPanel Orientation="Horizontal">
                                <local:AriaHiddenTextBlock TextTrimming="CharacterEllipsis">
                                    <local:AriaHiddenTextBlock.Style>
                                        <Style TargetType="local:AriaHiddenTextBlock">
                                            <Setter Property="Text" Value="{Binding Label}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </local:AriaHiddenTextBlock.Style>
                                </local:AriaHiddenTextBlock>
                                <!-- Unread badge: "(5)" — collapsed when empty. Opacity, not
                                     Theme.TextSecondary, so it follows the selection foreground. -->
                                <local:AriaHiddenTextBlock Margin="4,0,0,0"
                                                           Opacity="0.75"
                                                           FontSize="{DynamicResource Theme.FontSizeSmall}"
                                                           Text="{Binding UnreadDisplay}">
                                    <local:AriaHiddenTextBlock.Style>
                                        <Style TargetType="local:AriaHiddenTextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UnreadDisplay}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </local:AriaHiddenTextBlock.Style>
                                </local:AriaHiddenTextBlock>
                                <!-- Default-calendar marker: "(default)" — collapsed when empty.
                                     Same treatment as the unread badge; the accessible name
                                     carries the same state via AutomationName. -->
                                <local:AriaHiddenTextBlock Margin="4,0,0,0"
                                                           Opacity="0.75"
                                                           FontSize="{DynamicResource Theme.FontSizeSmall}"
                                                           Text="{Binding DefaultCalendarDisplay}">
                                    <local:AriaHiddenTextBlock.Style>
                                        <Style TargetType="local:AriaHiddenTextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DefaultCalendarDisplay}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </local:AriaHiddenTextBlock.Style>
                                </local:AriaHiddenTextBlock>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.Resources>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                            <Setter Property="IsExpanded"                  Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            <Setter Property="AutomationProperties.Name"   Value="{Binding AutomationName}"/>
                            <Setter Property="AutomationProperties.ItemStatus" Value="{Binding ItemStatusLabel}"/>
                            <!-- Tag exposes the window DataContext (MainViewModel) to the ContextMenu -->
                            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <Setter Property="ContextMenu" Value="{StaticResource FolderContextMenu}"/>
                            <Style.Triggers>
                                <!-- Calendar nodes get calendar actions, not folder actions (#497). -->
                                <DataTrigger Binding="{Binding IsCalendarNode}" Value="True">
                                    <Setter Property="ContextMenu" Value="{StaticResource CalendarContextMenu}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          DragCompleted="PaneSplitter_DragCompleted"
                          IsTabStop="False"
                          AutomationProperties.Name="Resize left and right panes"/>

            <!-- Right pane: messages + body (body docked to bottom, hidden until Enter on a message) -->
            <Grid Grid.Column="2">
            <DockPanel>

                <!-- Tab strip — visible only when message tabs are open -->
                <Border DockPanel.Dock="Top"
                        x:Name="TabStripBorder"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{DynamicResource Theme.Border}"
                        Background="{DynamicResource Theme.ChromeBackground}"
                        Visibility="{Binding ShowTabStrip, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ListBox x:Name="TabStrip"
                             ItemsSource="{Binding OpenTabs}"
                             SelectedItem="{Binding ActiveTab, Mode=TwoWay}"
                             SelectionMode="Single"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             KeyboardNavigation.TabNavigation="Once"
                             AutomationProperties.Name="Open message tabs"
                             SelectionChanged="TabStrip_SelectionChanged"
                             PreviewKeyDown="TabStrip_PreviewKeyDown"
                             PreviewMouseDown="TabStrip_PreviewMouseDown"
                             GotKeyboardFocus="TabStrip_GotKeyboardFocus"
                             LostKeyboardFocus="TabStrip_LostKeyboardFocus">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="8,5"/>
                                <Setter Property="Margin" Value="0,0,1,0"/>
                                <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
                                <Setter Property="ToolTip" Value="{Binding Title}"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Title}"
                                               MaxWidth="160"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                    <Button Content="✕"
                                            Width="16" Height="16"
                                            Padding="0"
                                            Margin="6,0,0,0"
                                            FontSize="9"
                                            Click="TabCloseButton_Click"
                                            Tag="{Binding}"
                                            IsTabStop="False"
                                            AutomationProperties.Name="Close this tab"
                                            ToolTip="Close tab"
                                            Visibility="{Binding CanClose, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- Content region: the message-list area (row 0) and the reading/body pane (row 1).
                     In Reading Pane mode the list fills and the body docks below as a resizable-height
                     sliver. When a message is opened in a *tab* (Tab mode), IsMessageListAreaVisible
                     becomes false: the list row collapses to 0 and the body row takes all the space, so
                     the tab shows just the message rather than a copy of the list with a body sliver. -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="{Binding IsPrimaryContentAreaVisible, Converter={StaticResource BoolToGridLengthConverter}, ConverterParameter='*|0'}"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition x:Name="ReadingPaneRow" Height="0" MinHeight="0"/>
                    </Grid.RowDefinitions>

                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"
                              ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                              Visibility="{Binding IsMessageOpen, Converter={StaticResource BoolToVisibilityConverter}}"
                              DragCompleted="PaneSplitter_DragCompleted"/>

                <!-- Body pane — hidden until IsMessageOpen; Escape returns to MessageList -->
                <Border Grid.Row="2"
                        BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource Theme.Border}"
                        MinHeight="200"
                        Visibility="{Binding IsMessageOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="8,6,8,0">
                            <Grid>
                              <StackPanel Margin="0,0,175,0">
                               <DockPanel>
                                 <TextBlock Text="Subject:" Width="58" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                 <TextBox x:Name="SubjectField"
                                      Text="{Binding MessageDetail.Subject, FallbackValue='', Mode=OneWay}"
                                      IsReadOnly="True" IsReadOnlyCaretVisible="True"
                                      BorderThickness="0" Background="Transparent"
                                      FontSize="{DynamicResource Theme.FontSizeBase}" FontWeight="SemiBold" TextWrapping="Wrap"
                                      AutomationProperties.Name="Subject"/>
                               </DockPanel>
                               <DockPanel Margin="0,2,0,0">
                                 <TextBlock Text="From:" Width="58" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                 <TextBox x:Name="FromField" Text="{Binding MessageDetail.From, FallbackValue='', Mode=OneWay}"
                                      IsReadOnly="True" IsReadOnlyCaretVisible="True" TextWrapping="Wrap"
                                      BorderThickness="0" Background="Transparent" AutomationProperties.Name="From"/>
                               </DockPanel>
                               <DockPanel>
                                 <TextBlock Text="To:" Width="58" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                 <TextBox x:Name="ToField" Text="{Binding MessageDetail.To, FallbackValue='', Mode=OneWay}"
                                      IsReadOnly="True" IsReadOnlyCaretVisible="True" TextWrapping="Wrap"
                                      BorderThickness="0" Background="Transparent" AutomationProperties.Name="To"/>
                               </DockPanel>
                               <DockPanel>
                                 <DockPanel.Style>
                                   <Style TargetType="DockPanel">
                                     <Style.Triggers>
                                       <DataTrigger Binding="{Binding MessageDetail.Cc}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                       <DataTrigger Binding="{Binding MessageDetail.Cc}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                     </Style.Triggers>
                                   </Style>
                                 </DockPanel.Style>
                                 <TextBlock Text="CC:" Width="58" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                 <TextBox x:Name="CcField" Text="{Binding MessageDetail.Cc, FallbackValue='', Mode=OneWay}"
                                      IsReadOnly="True" IsReadOnlyCaretVisible="True" TextWrapping="Wrap"
                                      BorderThickness="0" Background="Transparent" AutomationProperties.Name="Cc"/>
                               </DockPanel>
                               <DockPanel>
                                 <DockPanel.Style>
                                   <Style TargetType="DockPanel">
                                     <Style.Triggers>
                                       <DataTrigger Binding="{Binding MessageDetail.Bcc}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                       <DataTrigger Binding="{Binding MessageDetail.Bcc}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                     </Style.Triggers>
                                   </Style>
                                 </DockPanel.Style>
                                 <TextBlock Text="BCC:" Width="58" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                 <TextBox Text="{Binding MessageDetail.Bcc, FallbackValue='', Mode=OneWay}"
                                      IsReadOnly="True" IsReadOnlyCaretVisible="True" TextWrapping="Wrap"
                                      BorderThickness="0" Background="Transparent" AutomationProperties.Name="Bcc"/>
                               </DockPanel>
                               <DockPanel>
                                 <TextBlock Text="Date:" Width="58" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                 <TextBox x:Name="DateField" Text="{Binding MessageDetail.Date, StringFormat='{}{0:f}', FallbackValue='', Mode=OneWay}"
                                      IsReadOnly="True" IsReadOnlyCaretVisible="True"
                                      BorderThickness="0" Background="Transparent" AutomationProperties.Name="Date"/>
                               </DockPanel>
                              </StackPanel>
                              <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8,0,0,0">
                                <Button Content="Detach Preview" Padding="10,3"
                                      Click="DetachReadingPane_Click"
                                      ToolTip="Open the preview on another screen; it follows the selected message"/>
                                <Button x:Name="UnsubscribeButton" Content="Unsubscribe" Margin="0,5,0,0" Padding="10,4"
                                      FontWeight="SemiBold" Visibility="Collapsed"
                                      Background="{DynamicResource Theme.WarningBackground}"
                                      BorderBrush="{DynamicResource Theme.Warning}"
                                      Click="Unsubscribe_Click"
                                      AutomationProperties.Name="Unsubscribe from this sender"/>
                                <Button x:Name="MaintainSubscriptionButton" Content="Maintain subscription"
                                      Margin="0,3,0,0" Padding="8,3" Visibility="Collapsed"
                                      Click="MaintainSubscription_Click"
                                      AutomationProperties.Name="Keep subscription and hide unsubscribe controls for this sender"/>
                              </StackPanel>
                            </Grid>

                            <!-- Attachments (visible when selected message has attachments) -->
                            <ListBox x:Name="ReadingPaneAttachmentList"
                                     ItemsSource="{Binding MessageDetail.VisibleAttachments}"
                                     SelectionMode="Single"
                                     BorderThickness="0"
                                     Margin="0,4,0,0"
                                     Visibility="{Binding SelectedMessage.HasAttachments,
                                                  Converter={StaticResource BoolToVisibilityConverter},
                                                  FallbackValue=Collapsed}"
                                     KeyboardNavigation.TabNavigation="Once"
                                     KeyboardNavigation.DirectionalNavigation="Contained"
                                     AutomationProperties.Name="Attachments"
                                     PreviewKeyDown="ReadingPaneAttachmentList_PreviewKeyDown"
                                     PreviewMouseLeftButtonDown="ReadingPaneAttachmentList_PreviewMouseLeftButtonDown"
                                     PreviewMouseMove="ReadingPaneAttachmentList_PreviewMouseMove"
                                     MouseDoubleClick="ReadingPaneAttachmentList_MouseDoubleClick"
                                     GotKeyboardFocus="ReadingPaneAttachmentList_GotKeyboardFocus">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource Theme.AccentSubtle}"
                                                BorderBrush="{DynamicResource Theme.Border}"
                                                BorderThickness="1" CornerRadius="3"
                                                Padding="7,3" Margin="2,1">
                                            <TextBlock Text="{Binding FileName}" ToolTip="{Binding FileSizeDisplay}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="_Save…"
                                                  Command="{Binding PlacementTarget.DataContext.SaveAttachmentCommand,
                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.SelectedItem,
                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <MenuItem Header="Save _All…"
                                                  Command="{Binding PlacementTarget.DataContext.SaveAllAttachmentsCommand,
                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <MenuItem Header="_Open"
                                                  Command="{Binding PlacementTarget.DataContext.OpenAttachmentCommand,
                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.SelectedItem,
                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <Separator/>
                                        <MenuItem Header="_Copy attachment"
                                                  Click="AttachmentContextMenu_CopyPath_Click"
                                                  Tag="{Binding PlacementTarget.SelectedItem,
                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <MenuItem Header="_Explore"
                                                  Click="AttachmentContextMenu_Explore_Click"
                                                  Tag="{Binding PlacementTarget.SelectedItem,
                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                            </ListBox>

                            <Separator Margin="0,4,0,0"/>
                        </StackPanel>
                        <!-- WebView2: real browser, proper arrow-key caret nav, screen-reader virtual cursor -->
                        <wv2:WebView2 x:Name="MessageBody"
                                      AutomationProperties.Name="Message body"
                                      KeyboardNavigation.IsTabStop="True"
                                      GotKeyboardFocus="MessageBody_GotKeyboardFocus"
                                      MinHeight="80"/>
                    </DockPanel>
                </Border>

                <!-- Message list — fills row 0; collapses entirely when a message tab fills the pane -->
                <DockPanel Grid.Row="0"
                           Visibility="{Binding IsMessageListAreaVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ToolBar x:Name="MainToolbar" DockPanel.Dock="Top"
                             AutomationProperties.Name="Message toolbar"
                             KeyboardNavigation.TabNavigation="None"
                             KeyboardNavigation.DirectionalNavigation="Cycle"
                             PreviewKeyDown="Toolbar_PreviewKeyDown">
                        <Button Style="{DynamicResource ToolbarButton}" Content="Check Mail"
                                Click="CheckMailButton_Click" AutomationProperties.Name="Check mail"
                                ToolTip="Check IMAP mail, download incoming POP3 mail, and send queued messages"/>
                        <Separator/>
                        <Button x:Name="ToolbarFirstButton" Style="{DynamicResource ToolbarButton}"
                                Command="{Binding NewMessageCommand}" Content="New"
                                AutomationProperties.Name="New Message" ToolTip="New Message (Ctrl+N)"/>
                        <Separator/>
                        <Button Style="{DynamicResource ToolbarButton}" Command="{Binding ReplyCommand}"
                                Content="Reply" AutomationProperties.Name="Reply" ToolTip="Reply (Ctrl+R)"/>
                        <Button Style="{DynamicResource ToolbarButton}" Command="{Binding ReplyAllCommand}"
                                Content="Reply All" AutomationProperties.Name="Reply All" ToolTip="Reply All (Ctrl+Shift+R)"/>
                        <Button Style="{DynamicResource ToolbarButton}" Command="{Binding ForwardCommand}"
                                Content="Forward" AutomationProperties.Name="Forward" ToolTip="Forward (Ctrl+F)"/>
                        <Border x:Name="UndoSendBanner"
                                Visibility="Collapsed"
                                Margin="8,1,2,1" Padding="2"
                                CornerRadius="3"
                                Background="{DynamicResource Theme.WarningBackground}"
                                BorderBrush="{DynamicResource Theme.Warning}"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Right"
                                        Content="×"
                                        Click="DismissUndoSend_Click"
                                        Padding="5,1" Margin="3,0,0,0"
                                        Background="Transparent" BorderThickness="0"
                                        ToolTip="Hide this notice without cancelling the send"
                                        AutomationProperties.Name="Dismiss undo send notice"/>
                                <Button x:Name="UndoSendButton"
                                        Click="UndoSendButton_Click"
                                        Padding="6,1"
                                        Background="Transparent" BorderThickness="0"
                                        ToolTip="Cancel this queued message and save it in Draft">
                                    <TextBlock x:Name="UndoSendText"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="430"
                                               FontWeight="SemiBold"/>
                                </Button>
                            </DockPanel>
                        </Border>
                        <Button x:Name="SyncRangeButton" Visibility="Collapsed"/>
                        <Button x:Name="ViewModeButton" Visibility="Collapsed"/>
                    </ToolBar>
                    <TextBlock DockPanel.Dock="Top"
                               Text="{Binding SelectedFolder.DisplayName, FallbackValue='No folder selected'}"
                               FontWeight="SemiBold" Padding="6,4"
                               Focusable="False"
                               Background="{DynamicResource Theme.ChromeBackground}"
                               AutomationProperties.Name="Current folder"/>

                    <!-- Contact-mail results bar (#370) — visible only while the message list is
                         showing "mail from / to a contact". Mirrors the search bar below: the
                         match count plus a Close that returns to the folder the search started
                         from, so the results are never a dead end. Escape does the same. -->
                    <Border DockPanel.Dock="Top"
                            Padding="6,4"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource Theme.Border}"
                            Visibility="{Binding IsContactMailView, Converter={StaticResource BoolToVisibilityConverter}}">
                        <DockPanel>
                            <!-- Click rather than a direct command binding: closing also moves
                                 focus to the message list and announces the result, both View
                                 concerns the VM must not reach into. -->
                            <Button DockPanel.Dock="Right"
                                    Content="Close"
                                    Click="CloseContactMailResults_Click"
                                    AutomationProperties.Name="Close search results"
                                    ToolTip="Close these results and go back (Escape)"
                                    IsTabStop="True"/>
                            <TextBlock VerticalAlignment="Center"
                                       Margin="0,0,6,0"
                                       Focusable="False"
                                       Text="{Binding Messages.Count, StringFormat='{}{0} found'}"/>
                        </DockPanel>
                    </Border>

                    <!-- Search bar — visible only while IsSearchActive -->
                    <Border DockPanel.Dock="Top"
                            Padding="6,4"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource Theme.Border}"
                            Visibility="{Binding IsSearchActive, Converter={StaticResource BoolToVisibilityConverter}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Content="Clear"
                                    Command="{Binding ClearSearchCommand}"
                                    AutomationProperties.Name="Clear search"
                                    ToolTip="Clear search (Escape)"
                                    IsTabStop="True"/>
                            <Button DockPanel.Dock="Right" Content="?" Width="28" Margin="6,0,0,0"
                                    Click="QuickSearchHelpButton_Click"
                                    AutomationProperties.Name="Quick search syntax help"
                                    ToolTip="Show quick search prefixes and examples"/>
                            <Button DockPanel.Dock="Right" Content="Search" Margin="6,0,0,0"
                                    Click="SearchButton_Click" IsDefault="True"
                                    AutomationProperties.Name="Execute message search"/>
                            <Button DockPanel.Dock="Right" Content="Search Everywhere" Margin="6,0,0,0"
                                    Click="SearchEverywhereButton_Click"
                                    AutomationProperties.Name="Search all mail folders"
                                    ToolTip="Run this search across all materialized mail, regardless of the selected folder"/>
                            <Button DockPanel.Dock="Right" Content="Advanced Search" Margin="6,0,0,0"
                                    Click="AdvancedSearchButton_Click"
                                    AutomationProperties.Name="Open advanced message search"/>
                            <Button DockPanel.Dock="Right" Content="Save as Virtual Folder…" Margin="6,0,0,0"
                                    Click="SaveSearchAsVirtualFolderButton_Click"
                                    AutomationProperties.Name="Save this search as a virtual folder"
                                    ToolTip="Create a user-selected virtual folder under Views from this search"/>
                            <TextBlock DockPanel.Dock="Right"
                                       VerticalAlignment="Center"
                                       Margin="6,0"
                                       Focusable="False"
                                       Text="{Binding Messages.Count, StringFormat='{}{0} found'}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button DockPanel.Dock="Right"
                                    Content="▼" Width="28" Margin="0,0,4,0"
                                    Click="SearchHistoryButton_Click"
                                    AutomationProperties.Name="Show recent searches"
                                    ToolTip="Show the last ten searches"
                                    Focusable="False"/>
                            <ComboBox x:Name="SearchBox"
                                      IsEditable="True"
                                      IsTextSearchEnabled="False"
                                      controls:ComboBoxAssist.ShowDropDownButton="False"
                                      StaysOpenOnEdit="True"
                                      MaxDropDownHeight="320"
                                      Text="{Binding SearchText, UpdateSourceTrigger=Explicit}"
                                      AutomationProperties.Name="Search messages"
                                      ToolTip="Search messages, or select one of the last ten searches. Enter searches the current folder; Ctrl+Enter searches everywhere; Escape clears the search."
                                      PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                        </DockPanel>
                    </Border>

                    <TextBlock DockPanel.Dock="Top"
                               Text="No messages"
                               HorizontalAlignment="Center" Margin="0,20">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Messages.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Standard list view and conversation tree occupy the same space;
                         only one is visible at a time based on ViewMode. -->
                    <Grid>
                    <!-- Calendar (master/detail) — shown in place of the message list when the
                         Calendar virtual folder is selected. A columned event list (Subject /
                         When / Status) on top, a read-only Details pane below. Up/Down to browse,
                         Enter to open (edit an appointment, or the source invite), N new, E edit,
                         Delete to remove, T today, F5 refresh, Escape to return to the folder tree. -->
                    <Grid Visibility="{Binding IsCalendarView, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>

                        <!-- View switch + period navigation. Arrows stay within the group. -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="6,4,6,0"
                                    KeyboardNavigation.TabNavigation="Continue"
                                    KeyboardNavigation.DirectionalNavigation="Contained">
                            <Button Content="_Agenda" AutomationProperties.Name="Agenda view"
                                    MinWidth="64" Margin="0,0,4,0" Click="CalendarAgenda_Click"/>
                            <Button Content="_Day" AutomationProperties.Name="Day view"
                                    MinWidth="52" Margin="0,0,4,0" Click="CalendarDay_Click"/>
                            <Button Content="_Week" AutomationProperties.Name="Week view"
                                    MinWidth="56" Margin="0,0,4,0" Click="CalendarWeek_Click"/>
                            <Button Content="_Month" AutomationProperties.Name="Month view"
                                    MinWidth="56" Margin="0,0,12,0" Click="CalendarMonth_Click"/>
                            <Button Content="◀" AutomationProperties.Name="Previous period"
                                    MinWidth="32" Margin="0,0,4,0" Click="CalendarPrev_Click"/>
                            <Button Content="Today" AutomationProperties.Name="Go to today"
                                    MinWidth="56" Margin="0,0,4,0" Click="CalendarToday_Click"/>
                            <Button Content="▶" AutomationProperties.Name="Next period"
                                    MinWidth="32" Margin="0,0,12,0" Click="CalendarNext_Click"/>
                            <Button Content="_Go To Date…" AutomationProperties.Name="Go to date"
                                    MinWidth="96" Margin="0,0,8,0" Click="CalendarGoToDate_Click"/>
                            <Button Content="_Refresh (F5)" AutomationProperties.Name="Refresh calendar, F5"
                                    MinWidth="96" Click="CalendarRefresh_Click"/>
                        </StackPanel>

                        <!-- Period label + search + item toolbar -->
                        <DockPanel Grid.Row="1" Margin="6,4" LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left"
                                       Text="{Binding CalendarVm.PeriodLabel}"
                                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBox x:Name="CalendarSearchBox"
                                     DockPanel.Dock="Left"
                                     AutomationProperties.Name="Search appointments"
                                     Text="{Binding CalendarVm.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding CalendarVm.IsSearchActive, Converter={StaticResource BoolToVisibilityConverter}}"
                                     MinWidth="160" Margin="12,0,0,0" VerticalAlignment="Center"
                                     PreviewKeyDown="CalendarSearchBox_PreviewKeyDown"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                        KeyboardNavigation.TabNavigation="Continue"
                                        KeyboardNavigation.DirectionalNavigation="Contained">
                                <Button Content="_New" AutomationProperties.Name="New appointment"
                                        MinWidth="64" Margin="0,0,6,0" Click="CalendarNew_Click"/>
                                <Button Content="_Edit" AutomationProperties.Name="Edit appointment"
                                        MinWidth="64" Margin="0,0,6,0" Click="CalendarEdit_Click"/>
                                <Button Content="De_lete" AutomationProperties.Name="Delete appointment"
                                        MinWidth="64" Click="CalendarDelete_Click"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- Month grid — a 7-column day grid shown instead of the event list in
                             Month view. Arrows move spatially (left/right = day, up/down = week);
                             Enter drills into that day. Each cell speaks "Tuesday June 9, 3 events". -->
                        <ListBox x:Name="MonthGrid"
                                 Grid.Row="2"
                                 AutomationProperties.Name="Month grid"
                                 Visibility="Collapsed"
                                 ItemsSource="{Binding CalendarVm.MonthCells}"
                                 SelectedItem="{Binding CalendarVm.SelectedMonthCell, Mode=TwoWay}"
                                 BorderThickness="0"
                                 KeyboardNavigation.TabNavigation="Once"
                                 KeyboardNavigation.DirectionalNavigation="Contained"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CellText}" Padding="6,8" TextAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsInMonth}" Value="False">
                                                        <Setter Property="Opacity" Value="0.45"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <ListView x:Name="CalendarList"
                                  Grid.Row="2"
                                  AutomationProperties.Name="Calendar events"
                                  Visibility="{Binding CalendarVm.IsAgendaView, Converter={StaticResource BoolToVisibilityConverter}}"
                                  ItemsSource="{Binding CalendarVm.Events}"
                                  SelectedItem="{Binding CalendarVm.SelectedEvent, Mode=TwoWay}"
                                  BorderThickness="0"
                                  TabIndex="3"
                                  KeyboardNavigation.TabNavigation="Once"
                                  KeyboardNavigation.DirectionalNavigation="Contained"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  GotKeyboardFocus="CalendarList_GotKeyboardFocus"
                                  PreviewKeyDown="CalendarList_PreviewKeyDown">
                            <ListView.ItemContainerStyle>
                                <!-- BasedOn the GRIDVIEW container style, not the plain ListViewItem
                                     style: the plain one's template hosts a ContentPresenter, so rows
                                     rendered item.ToString() ("QuickMail.Models.CalendarEvent") and the
                                     columns never appeared (#448). Invisible to a screen reader — the
                                     row name below was always correct — which is why it took the visual
                                     harness to catch it. -->
                                <Style TargetType="ListViewItem"
                                       BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}">
                                    <!-- Row name = the stamped accessible name (data-only or field-labeled
                                         per the CalendarListShowFieldLabels setting); the visual columns
                                         aid sighted users. -->
                                    <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Subject" Width="260"
                                                    DisplayMemberBinding="{Binding Summary}"/>
                                    <GridViewColumn Header="When" Width="170"
                                                    DisplayMemberBinding="{Binding WhenText}"/>
                                    <GridViewColumn Header="Status" Width="110"
                                                    DisplayMemberBinding="{Binding StatusText}"/>
                                    <GridViewColumn Header="Calendar" Width="150"
                                                    DisplayMemberBinding="{Binding CalendarSourceLabel}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <!-- FullCalendar Standard renders the interactive Day / Week / Month views.
                             The bundle is vendored locally: calendar browsing remains available offline. -->
                        <wv2:WebView2 x:Name="CalendarWebView"
                                      Grid.Row="2"
                                      Visibility="{Binding CalendarVm.IsAgendaView, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                      AutomationProperties.Name="Interactive calendar"
                                      NavigationCompleted="CalendarWebView_NavigationCompleted"/>

                        <GridSplitter Grid.Row="3" Height="4" HorizontalAlignment="Stretch"
                                      ResizeBehavior="PreviousAndNext" ResizeDirection="Rows"
                                      IsTabStop="False"
                                      Background="{DynamicResource Theme.Border}"/>

                        <TextBox x:Name="CalendarDetails"
                                 Grid.Row="4"
                                 AutomationProperties.Name="Appointment details"
                                 Text="{Binding CalendarVm.SelectedEventDetail, Mode=OneWay}"
                                 IsReadOnly="True"
                                 IsReadOnlyCaretVisible="True"
                                 TextChanged="CalendarDetails_TextChanged"
                                 TabIndex="4"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 BorderThickness="0"
                                 Margin="4"/>
                    </Grid>

                    <!-- Represents the complete result set, not merely the loaded 2,000-row page. -->
                    <ScrollBar x:Name="TotalMessageScrollBar"
                               Panel.ZIndex="20" Orientation="Vertical" Width="16"
                               HorizontalAlignment="Right" VerticalAlignment="Stretch"
                               Minimum="0" Maximum="{Binding LocalMaximumMessageIndex}"
                               ViewportSize="2000" SmallChange="3" LargeChange="25"
                               Visibility="{Binding IsMessagesView, Converter={StaticResource BoolToVisibilityConverter}}"
                               Scroll="TotalMessageScrollBar_Scroll"/>

                    <ListView x:Name="MessageList"
                              AutomationProperties.Name="Messages"
                              ContextMenu="{StaticResource MessageContextMenu}"
                              ItemsSource="{Binding Messages}"
                              SelectedItem="{Binding SelectedMessage, Mode=TwoWay}"
                              SelectionChanged="MessageList_SelectionChanged"
                              SelectionMode="Extended"
                              BorderThickness="0"
                              TabIndex="3"
                              KeyboardNavigation.TabNavigation="Once"
                              KeyboardNavigation.DirectionalNavigation="Contained"
                              GotKeyboardFocus="List_GotKeyboardFocus"
                              PreviewTextInput="MessageList_PreviewTextInput"
                              PreviewKeyDown="MessageList_PreviewKeyDown"
                              PreviewMouseLeftButtonDown="MessageList_PreviewMouseLeftButtonDown"
                              PreviewMouseLeftButtonUp="MessageList_PreviewMouseLeftButtonUp"
                              PreviewMouseMove="MessageList_PreviewMouseMove"
                              PreviewMouseWheel="MessageList_PreviewMouseWheel"
                              ScrollViewer.CanContentScroll="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.VerticalScrollBarVisibility="Hidden"
                              Margin="0,0,16,0"
                              MouseDoubleClick="MessageList_MouseDoubleClick"
                              MouseLeftButtonUp="MessageList_MouseLeftButtonUp">
                        <ListView.Style>
                            <Style TargetType="ListView" BasedOn="{StaticResource {x:Type ListView}}">
                                <Setter Property="Visibility" Value="{Binding IsMessagesView, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCalendarView}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.Style>
                        <!-- Column headers are mouse-clickable but not keyboard tab stops:
                             Focusable=False comes from the app-wide GridViewColumnHeader styles
                             (AccessibleStyles + ThemedControls), so the themed header template
                             is not shadowed by a local style here. -->
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="66">
                                    <GridViewColumn.Header>
                                        <GridViewColumnHeader Content="In/Out" Tag="Direction"
                                                              AutomationProperties.IsColumnHeader="True"/>
                                    </GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DirectionDisplay}"
                                                       FontSize="{DynamicResource Theme.FontSizeSmall}"
                                                       TextAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="30">
                                    <GridViewColumn.Header>
                                        <GridViewColumnHeader Content="&#x21A9;" ToolTip="Replied"
                                                              AutomationProperties.Name="Replied"
                                                              AutomationProperties.IsColumnHeader="True"/>
                                    </GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ReplyIndicator}"
                                                       FontFamily="Segoe UI Symbol"
                                                       FontSize="{DynamicResource Theme.FontSizeSmall}"
                                                       TextAlignment="Center"
                                                       AutomationProperties.Name="{Binding ReadStatusLabel}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="90">
                                    <GridViewColumn.Header>
                                        <GridViewColumnHeader Content="Status" Tag="Status"
                                                   AutomationProperties.IsColumnHeader="True"/>
                                    </GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StatusDisplay}"
                                                       FontSize="{DynamicResource Theme.FontSizeSmall}"
                                                       TextAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="180">
                                    <GridViewColumn.Header>
                                        <GridViewColumnHeader Content="From" Tag="From"
                                                              AutomationProperties.IsColumnHeader="True"/>
                                    </GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding From}"
                                                       FontWeight="{Binding IsRead, Converter={StaticResource BoolToWeightConverter}}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="180">
                                    <GridViewColumn.Header>
                                        <GridViewColumnHeader Content="To" Tag="To" AutomationProperties.IsColumnHeader="True"/>
                                    </GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding To}" TextTrimming="CharacterEllipsis" ToolTip="{Binding To}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="Auto">
                                    <GridViewColumn.Header>
                                        <GridViewColumnHeader Content="Subject" Tag="Subject"
                                                              AutomationProperties.IsColumnHeader="True"/>
                                    </GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Subject}"
                                                       FontWeight="{Binding IsRead, Converter={StaticResource BoolToWeightConverter}}"
