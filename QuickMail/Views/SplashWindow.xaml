<Window x:Class="QuickMail.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Eudora QuickMail" Width="520" Height="260"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen" Topmost="True"
        Background="#F4F8FC" Foreground="#17212B">
    <Border BorderBrush="#5B9BD5" BorderThickness="1" CornerRadius="6" Padding="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Source="/Assets/App/QuickMail.ico" Width="72" Height="72" Margin="0,0,0,12"/>
                <TextBlock Text="Eudora QuickMail" FontFamily="Segoe UI" FontSize="26"
                           FontWeight="SemiBold" HorizontalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" Grid.Row="1" Margin="0,16,0,10"
                       Text="Starting…" TextAlignment="Center" TextWrapping="Wrap"
                       FontFamily="Segoe UI" FontSize="13"/>
            <ProgressBar Grid.Row="2" Height="5" IsIndeterminate="True"/>
        </Grid>
    </Border>
</Window>
