<Window x:Class="QuickMail.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Eudora QuickMail" Width="520" Height="278"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen" Topmost="True"
        Background="{DynamicResource Theme.WindowBackground}"
        Foreground="{DynamicResource Theme.TextPrimary}"
        FontFamily="{DynamicResource Theme.FontFamily}"
        FontSize="{DynamicResource Theme.FontSizeBase}">
    <Border BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="6" Padding="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Width="128" Height="128" Margin="0,0,0,8" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Source="pack://application:,,,/EudoraQM;component/Assets/App/QuickMail.png"
                       AutomationProperties.Name="Eudora QuickMail logo"/>
                <TextBlock Text="Eudora QuickMail" FontSize="{DynamicResource Theme.FontSizeHeader}"
                           FontWeight="SemiBold" HorizontalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" Grid.Row="1" Margin="0,16,0,10"
                       Text="Starting…" TextAlignment="Center" TextWrapping="Wrap"
                       FontSize="{DynamicResource Theme.FontSizeBase}"/>
            <ProgressBar Grid.Row="2" Height="5" IsIndeterminate="True"/>
        </Grid>
    </Border>
</Window>
