<Window x:Class="QuickMail.Views.UnsubscribeOpenChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Open unsubscribe page" Width="680" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Theme.WindowBackground}"
        ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="How would you like to open the unsubscribe page?"
                       FontSize="{DynamicResource Theme.FontSizeLarge}"
                       FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource Theme.TextSecondary}">
                The isolated browser is safer, but some sites require cookies or browser features
                that are only available in your default browser.
            </TextBlock>
        </StackPanel>

        <TextBox x:Name="AddressField" Grid.Row="1" Margin="0,14,0,16" Padding="7"
                 IsReadOnly="True" IsReadOnlyCaretVisible="True" TextWrapping="Wrap"
                 MaxHeight="90" VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="Unsubscribe address"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Open isolated" MinWidth="112" Margin="0,0,8,0" Padding="12,5"
                    IsDefault="True" Click="OpenIsolated_Click"
                    AutomationProperties.Name="Open unsubscribe page in isolated browser"/>
            <Button Content="Open in default browser" MinWidth="154" Margin="0,0,8,0" Padding="12,5"
                    Click="OpenDefaultBrowser_Click"
                    AutomationProperties.Name="Open unsubscribe page in default browser"/>
            <Button Content="Cancel" MinWidth="82" Padding="12,5" IsCancel="True"
                    Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
