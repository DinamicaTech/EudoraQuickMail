<Window x:Class="QuickMail.Views.UnsubscribeBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Unsubscribe — isolated browser" Width="940" Height="720"
        MinWidth="620" MinHeight="420" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Theme.WindowBackground}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="8" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource Theme.Border}"
                Background="{DynamicResource Theme.ChromeBackground}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Close" Padding="14,4"
                        Click="Close_Click" AutomationProperties.Name="Close isolated browser"/>
                <TextBox x:Name="AddressField" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                         BorderThickness="0" Background="Transparent" TextWrapping="Wrap"
                         AutomationProperties.Name="Unsubscribe address"/>
            </DockPanel>
        </Border>
        <TextBlock x:Name="LoadingText" Text="Opening the unsubscribe page in an isolated browser…"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{DynamicResource Theme.TextSecondary}"/>
        <wv2:WebView2 x:Name="Browser" Visibility="Collapsed"
                      AutomationProperties.Name="Isolated unsubscribe page"/>
    </DockPanel>
</Window>
