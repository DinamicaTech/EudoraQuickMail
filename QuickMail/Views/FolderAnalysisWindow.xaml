<Window x:Class="QuickMail.Views.FolderAnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Analyze Folder" Height="560" Width="620"
        MinHeight="400" MinWidth="460" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Theme.WindowBackground}"
        Foreground="{DynamicResource Theme.TextPrimary}"
        FontFamily="{DynamicResource Theme.FontFamily}"
        FontSize="{DynamicResource Theme.FontSizeBase}">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Folder analysis" FontSize="{DynamicResource Theme.FontSizeHeader}"
                       FontWeight="SemiBold"/>
            <TextBlock x:Name="ScopeText" Margin="0,4,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource Theme.TextSecondary}"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock x:Name="SummaryText" Margin="2,0,0,8"
                       Foreground="{DynamicResource Theme.TextSecondary}"/>
            <Button Content="Close" MinWidth="90" HorizontalAlignment="Right"
                    IsCancel="True" Click="Close_Click"/>
        </StackPanel>

        <Grid>
            <DataGrid x:Name="DomainGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Extended" SelectionUnit="FullRow"
                      CanUserSortColumns="True" EnableRowVirtualization="True"
                      MouseDoubleClick="DomainGrid_MouseDoubleClick"
                      AutomationProperties.Name="Top sender domains">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Sender domain" Binding="{Binding Domain}"
                                        Width="*" SortMemberPath="Domain"/>
                    <DataGridTextColumn Header="Messages"
                                        Binding="{Binding MessageCount, StringFormat={}{0:N0}}"
                                        Width="140" SortMemberPath="MessageCount">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="EmptyText" Text="No messages were found in this folder."
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource Theme.TextSecondary}"
                       Visibility="Collapsed"/>
        </Grid>
    </DockPanel>
</Window>
