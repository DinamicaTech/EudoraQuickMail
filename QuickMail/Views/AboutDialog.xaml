<Window x:Class="QuickMail.Views.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Eudora QuickMail"
        Height="275" Width="520"
        MinHeight="250" MinWidth="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Theme.WindowBackground}"
        Foreground="{DynamicResource Theme.TextPrimary}"
        FontFamily="{DynamicResource Theme.FontFamily}"
        FontSize="{DynamicResource Theme.FontSizeBase}">

    <DockPanel Margin="20">

        <Button DockPanel.Dock="Bottom"
                Content="_Close"
                IsCancel="True"
                MinWidth="75"
                HorizontalAlignment="Right"
                Margin="0,16,0,0"
                AutomationProperties.Name="Close"/>

        <StackPanel>
            <TextBlock Text="Eudora QuickMail"
                       FontSize="{DynamicResource Theme.FontSizeHeader}"
                       FontWeight="Bold"
                       Margin="0,0,0,6"/>
            <TextBlock x:Name="VersionText"
                       Margin="0,0,0,12"/>
            <TextBlock Text="Active data folder:" Margin="0,0,0,3"/>
            <TextBox x:Name="DataFolderText"
                     IsReadOnly="True" BorderThickness="1" Padding="5,3"
                     HorizontalScrollBarVisibility="Auto"
                     AutomationProperties.Name="Active data folder"
                     Margin="0,0,0,12"/>
            <TextBlock>
                <Hyperlink x:Name="LicenseLink"
                           NavigateUri="https://github.com/DinamicaTech/QuickMail/blob/main/LICENSE"
                           RequestNavigate="LicenseLink_RequestNavigate"
                           AutomationProperties.Name="View MIT License on GitHub">
                    MIT License
                </Hyperlink>
            </TextBlock>
        </StackPanel>

    </DockPanel>
</Window>
