<Window x:Class="QuickMail.Views.RepeatedSendWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:QuickMail.Controls"
        Title="Send repeatedly" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown"
        Background="{DynamicResource Theme.WindowBackground}" Foreground="{DynamicResource Theme.TextPrimary}"
        FontFamily="{DynamicResource Theme.FontFamily}" FontSize="{DynamicResource Theme.FontSizeBase}">
    <StackPanel Margin="16">
        <TextBlock Text="Send at 08:00 local time. Only the next occurrence is kept in Scheduled." TextWrapping="Wrap" Margin="0,0,0,10"/>
        <Label Content="_Start date" Target="{Binding ElementName=StartDate}"/>
        <controls:DateTimeField x:Name="StartDate" Kind="Date" AutomationProperties.Name="First sending date"/>
        <Label Content="Repeat every (days)" Target="{Binding ElementName=Interval}"/>
        <TextBox x:Name="Interval" AutomationProperties.Name="Interval in days" ToolTip="Whole days, at least 1. Dates stay aligned to the original schedule."/>
        <Label Content="_End date (inclusive)" Target="{Binding ElementName=EndDate}"/>
        <controls:DateTimeField x:Name="EndDate" Kind="Date" AutomationProperties.Name="Last possible sending date"/>
        <TextBlock Margin="0,12,0,12" TextWrapping="Wrap" Text="If QuickMail is closed, one overdue copy is sent on reopening. Missed repetitions are skipped. Delete the pending message in Scheduled to stop the series."/>
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Theme.Error}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Schedule" IsDefault="True" Click="Confirm_Click" Padding="12,4" Margin="0,0,8,0"/>
            <Button Content="Cancel" IsCancel="True" Click="Cancel_Click" Padding="12,4"/>
        </StackPanel>
    </StackPanel>
</Window>
