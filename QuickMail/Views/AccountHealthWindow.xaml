<Window x:Class="QuickMail.Views.AccountHealthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Account Health" Height="500" Width="1180"
        MinHeight="340" MinWidth="800" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Theme.WindowBackground}"
        Foreground="{DynamicResource Theme.TextPrimary}"
        FontFamily="{DynamicResource Theme.FontFamily}"
        FontSize="{DynamicResource Theme.FontSizeBase}"
        AutomationProperties.Name="Account health">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,10">
            <TextBlock Text="Mail account diagnostics" FontSize="{DynamicResource Theme.FontSizeHeader}" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <Button Content="Refresh" Click="Refresh_Click" DockPanel.Dock="Right"
                    MinWidth="85" Padding="10,4"/>
        </DockPanel>
        <ListView x:Name="HealthGrid" Grid.Row="1" SelectionMode="Single"
                  SizeChanged="HealthGrid_SizeChanged"
                  HorizontalContentAlignment="Stretch">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasProblem}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Theme.ErrorBackground}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Theme.Error}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView AllowsColumnReorder="True">
                    <GridViewColumn x:Name="AccountColumn" Header="Account" DisplayMemberBinding="{Binding Account}" Width="140"/>
                    <GridViewColumn x:Name="StateColumn" Header="State" DisplayMemberBinding="{Binding State}" Width="105"/>
                    <GridViewColumn x:Name="ProtocolColumn" Header="Protocol" DisplayMemberBinding="{Binding Protocol}" Width="105"/>
                    <GridViewColumn x:Name="IncomingColumn" Header="Incoming" DisplayMemberBinding="{Binding Incoming}" Width="150"/>
                    <GridViewColumn x:Name="OutgoingColumn" Header="Outgoing" DisplayMemberBinding="{Binding Outgoing}" Width="150"/>
                    <GridViewColumn x:Name="AuthenticationColumn" Header="Authentication" DisplayMemberBinding="{Binding Authentication}" Width="180"/>
                    <GridViewColumn x:Name="LastDownloadColumn" Header="Last download" DisplayMemberBinding="{Binding LastDownload}" Width="135"/>
                    <GridViewColumn x:Name="QueueColumn" Header="Queue" DisplayMemberBinding="{Binding Queue}" Width="120"/>
                    <GridViewColumn x:Name="LastErrorColumn" Header="Last error" DisplayMemberBinding="{Binding LastError}" Width="260"/>
                </GridView>
            </ListView.View>
        </ListView>
        <DockPanel Grid.Row="2" Margin="0,10,0,0" LastChildFill="False">
            <TextBlock x:Name="StatusText" Text="Checking accounts…" VerticalAlignment="Center"/>
            <Button Content="Close" IsCancel="True" MinWidth="80" Padding="10,4"
                    HorizontalAlignment="Right" DockPanel.Dock="Right"/>
        </DockPanel>
    </Grid>
</Window>
