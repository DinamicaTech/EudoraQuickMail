<Window x:Class="QuickMail.Views.RuleFilterSearchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Search Filters" Width="520" Height="340"
        MinWidth="420" MinHeight="300"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource Theme.WindowBackground}"
        Foreground="{DynamicResource Theme.TextPrimary}"
        FontFamily="{DynamicResource Theme.FontFamily}"
        FontSize="{DynamicResource Theme.FontSizeBase}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Enter one or more sample message criteria. Criteria are combined with AND."
                   TextWrapping="Wrap" Margin="0,0,0,10"/>
        <TextBlock Grid.Row="1" Text="From"/>
        <TextBox Grid.Row="2" x:Name="FromBox" Margin="0,2,0,8" Padding="4,3"/>
        <TextBlock Grid.Row="3" Text="To"/>
        <TextBox Grid.Row="4" x:Name="ToBox" Margin="0,2,0,8" Padding="4,3"/>
        <TextBlock Grid.Row="5" Text="Subject"/>
        <TextBox Grid.Row="6" x:Name="SubjectBox" Margin="0,2,0,8" Padding="4,3"/>
        <TextBlock Grid.Row="7" Text="Body"/>
        <TextBox Grid.Row="8" x:Name="BodyBox" Margin="0,2,0,8" Padding="4,3"/>
        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Clear" Click="Clear_Click" MinWidth="70" Margin="0,0,8,0"/>
            <Button Content="Search" Click="Search_Click" IsDefault="True" MinWidth="70" Margin="0,0,8,0"/>
            <Button Content="Cancel" IsCancel="True" MinWidth="70"/>
        </StackPanel>
    </Grid>
</Window>
